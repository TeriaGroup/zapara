<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Vograph.Desktop"
             x:Class="Vograph.Desktop.App"
             RequestedThemeVariant="Default">
  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Vograph/Theme/Typography.axaml" />
  </Application.Styles>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Vograph/Theme/Tokens.axaml" />
        <ResourceInclude Source="avares://Vograph/Theme/Icons.axaml" />
        <ResourceInclude Source="avares://Vograph/Theme/Controls/Buttons.axaml" />
        <ResourceInclude Source="avares://Vograph/Theme/Controls/Inputs.axaml" />
        <ResourceInclude Source="avares://Vograph/Theme/Controls/Custom.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>

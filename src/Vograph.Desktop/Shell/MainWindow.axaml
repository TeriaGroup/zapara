<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Vograph.Desktop.Controls"
        xmlns:shell="using:Vograph.Desktop.Shell"
        xmlns:loc="using:Vograph.Desktop.Services"
        xmlns:d="using:Vograph.Desktop.Dialogs"
        x:Class="Vograph.Desktop.Shell.MainWindow"
        x:DataType="shell:ShellViewModel"
        Title="Военмех — расписание и карты"
        Width="1280" Height="800" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="None"
        Background="{DynamicResource Brush.Canvas}">

  <!-- Digits must be spelled D1..D9: KeyGesture.Parse reads a bare "1" as the numeric Key value (Key.Cancel). -->
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+D1" Command="{Binding NavigateCommand}" CommandParameter="Schedule" />
    <KeyBinding Gesture="Ctrl+D2" Command="{Binding NavigateCommand}" CommandParameter="Week" />
    <KeyBinding Gesture="Ctrl+D3" Command="{Binding NavigateCommand}" CommandParameter="Summary" />
    <KeyBinding Gesture="Ctrl+D4" Command="{Binding NavigateCommand}" CommandParameter="Teachers" />
    <KeyBinding Gesture="Ctrl+D5" Command="{Binding NavigateCommand}" CommandParameter="Maps" />
    <KeyBinding Gesture="Ctrl+D6" Command="{Binding NavigateCommand}" CommandParameter="Friends" />
    <KeyBinding Gesture="Ctrl+D7" Command="{Binding NavigateCommand}" CommandParameter="Homework" />
    <KeyBinding Gesture="Ctrl+D8" Command="{Binding NavigateCommand}" CommandParameter="Settings" />
    <KeyBinding Gesture="Ctrl+D9" Command="{Binding NavigateCommand}" CommandParameter="Community" />
    <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding NavigateCommand}" CommandParameter="Settings" />
    <KeyBinding Gesture="Ctrl+B" Command="{Binding ToggleSidebarCommand}" />
    <KeyBinding Gesture="F5" Command="{Binding RefreshScheduleCommand}" />
    <!-- Enter is NOT bound here: Window.KeyBindings matches gestures even when a nested control (a
         multi-line TextBox inserting a newline) already marked the key event Handled. DialogHostView's
         own KeyDown handler respects that flag instead, so Enter only confirms when nothing consumed it.
         Escape is not bound here either: it has to pick between the dialog and the fullscreen map overlay,
         which ShellViewModel.HandleShortcut does from the bubbling OnShellKeyDown handler below. -->
  </Window.KeyBindings>

  <Panel x:Name="RootPanel">
    <Grid RowDefinitions="40,*" ColumnDefinitions="Auto,*">

      <!-- Custom title bar: the OS handles drag / double-click via ElementRole. -->
      <Border Grid.ColumnSpan="2" Background="{DynamicResource Brush.Surface}"
              BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1"
              WindowDecorationProperties.ElementRole="TitleBar">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8" Margin="16,0" VerticalAlignment="Center">
            <Border Width="18" Height="18" CornerRadius="5" Background="{DynamicResource Brush.Accent}">
              <Border Width="8" Height="8" CornerRadius="2" Background="{DynamicResource Brush.OnAccent}" />
            </Border>
            <TextBlock Text="Военмех" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Classes="caption" WindowDecorationProperties.ElementRole="MinimizeButton" Click="OnMinimize" ToolTip.Tip="{loc:T winMinimize}"
                    AutomationProperties.AutomationId="Win.Minimize" AutomationProperties.Name="{loc:T winMinimize}">
              <c:Icon Data="{StaticResource Icon.Minus}" Size="14" />
            </Button>
            <Button Classes="caption" WindowDecorationProperties.ElementRole="MaximizeButton" Click="OnMaximize" ToolTip.Tip="{Binding MaximizeTip}"
                    AutomationProperties.AutomationId="Win.Maximize" AutomationProperties.Name="{Binding MaximizeTip}">
              <c:Icon Data="{Binding IsMaximized, Converter={x:Static loc:Converters.MaximizeIcon}}" Size="12" />
            </Button>
            <Button Classes="caption close" WindowDecorationProperties.ElementRole="CloseButton" Click="OnClose" ToolTip.Tip="{loc:T winClose}"
                    AutomationProperties.AutomationId="Win.Close" AutomationProperties.Name="{loc:T winClose}">
              <c:Icon Data="{StaticResource Icon.X}" Size="14" />
            </Button>
          </StackPanel>
          <Panel />
        </DockPanel>
      </Border>

      <shell:SidebarView Grid.Row="1" Grid.Column="0" />

      <TransitioningContentControl x:Name="Host" Grid.Row="1" Grid.Column="1" Content="{Binding Current}"
                                   ClipToBounds="True"
                                   PageTransition="{Binding Motion.Enabled, Converter={x:Static loc:Converters.PageTransition}}" />
    </Grid>

    <ContentControl Content="{Binding Overlay}" IsVisible="{Binding HasOverlay}" />

    <d:DialogHostView DataContext="{Binding Dialogs}" />
    <c:ToastHost DataContext="{Binding Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,16" />
    <!-- Spec §7: the outgoing theme, snapshotted and fading away over the switched-over window underneath. -->
    <Image x:Name="ThemeSnapshot" IsVisible="False" IsHitTestVisible="False" Stretch="Fill" />
  </Panel>
</Window>

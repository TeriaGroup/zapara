<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vograph.Desktop.Controls"
             xmlns:d="using:Vograph.Desktop.Dialogs"
             xmlns:m="using:Vograph.Core.Models"
             xmlns:loc="using:Vograph.Desktop.Services"
             x:Class="Vograph.Desktop.Dialogs.GroupPickerDialogView"
             x:DataType="d:GroupPickerDialogViewModel">
  <StackPanel Spacing="12" Width="440">
    <TextBlock Classes="title" Text="{Binding Title}" />
    <TextBlock Text="Каталог недоступен. Укажите группу вручную; расписание появится после загрузки." TextWrapping="Wrap" IsVisible="{Binding AllowManual}" />
    <TextBox Text="{Binding ManualName}" PlaceholderText="Номер группы" IsVisible="{Binding AllowManual}" />
    <TextBox Name="SearchBox" Text="{Binding Query}" PlaceholderText="{loc:T groupSearchExample}" KeyDown="OnSearchKeyDown" IsVisible="{Binding ShowCatalog}"
             AutomationProperties.AutomationId="Dialog.Search">
      <TextBox.InnerLeftContent>
        <c:Icon Data="{StaticResource Icon.Search}" Size="14" Foreground="{DynamicResource Brush.Text3}" />
      </TextBox.InnerLeftContent>
    </TextBox>
    <ListBox x:Name="List" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" Height="320" DoubleTapped="OnDoubleTapped" IsVisible="{Binding ShowCatalog}"
             AutomationProperties.AutomationId="Dialog.List">
      <ListBox.Styles>
        <!-- #21: заголовки разделов («Недавние», «Факультет И») не выбираются и пропускаются стрелками. -->
        <Style Selector="ListBoxItem" x:DataType="d:GroupPickRow">
          <Setter Property="IsEnabled" Value="{Binding IsGroup}" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="d:GroupPickRow">
          <Panel>
            <TextBlock Classes="micro" Text="{Binding Header}" IsVisible="{Binding IsHeader}" Margin="0,6,0,0" />
            <c:HighlightText Source="{Binding Name}" IsVisible="{Binding IsGroup}"
                             Query="{Binding $parent[ListBox].((d:GroupPickerDialogViewModel)DataContext).Query}" />
          </Panel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="{loc:T cancel}" Command="{Binding CancelCommand}" AutomationProperties.AutomationId="Dialog.Cancel" />
      <Button Classes="primary" Content="{loc:T select}" Command="{Binding ConfirmCommand}" AutomationProperties.AutomationId="Dialog.Confirm" />
    </StackPanel>
  </StackPanel>
</UserControl>

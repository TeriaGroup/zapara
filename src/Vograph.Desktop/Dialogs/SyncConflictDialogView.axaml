<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="using:Vograph.Desktop.Dialogs"
             xmlns:loc="using:Vograph.Desktop.Services"
             x:Class="Vograph.Desktop.Dialogs.SyncConflictDialogView"
             x:DataType="d:SyncConflictDialogViewModel">
  <StackPanel Spacing="14" Width="400">
    <TextBlock Classes="title" Text="{Binding Title}" TextWrapping="Wrap" />
    <TextBlock Classes="muted" Text="{Binding Body}" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
      <Button Content="{loc:T cancel}" Command="{Binding CancelCommand}"
              AutomationProperties.AutomationId="Dialog.Cancel" />
      <Button Content="{Binding KeepServerText}" Command="{Binding KeepServerCommand}"
              IsVisible="{Binding CanChooseVersion}"
              AutomationProperties.AutomationId="Dialog.KeepServer"
              AutomationProperties.Name="{Binding KeepServerText}" />
      <Button Content="{Binding KeepLocalText}" Command="{Binding KeepLocalCommand}"
              Classes="primary" IsVisible="{Binding CanChooseVersion}"
              AutomationProperties.AutomationId="Dialog.KeepLocal"
              AutomationProperties.Name="{Binding KeepLocalText}" />
    </StackPanel>
  </StackPanel>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="using:Vograph.Desktop.Dialogs"
             x:Class="Vograph.Desktop.Dialogs.DialogHostView"
             x:DataType="d:DialogHostViewModel"
             KeyDown="OnKeyDown">
  <Panel x:Name="Root" Focusable="True" IsVisible="{Binding HasDialog}">
    <Border Background="{DynamicResource Brush.Backdrop}" PointerPressed="OnBackdropPressed" />
    <Border Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
            CornerRadius="{DynamicResource Radius.Dialog}" Padding="22" BoxShadow="{DynamicResource Shadow.Dialog}"
            HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="440" MaxWidth="640">
      <ContentControl Content="{Binding Current}" />
    </Border>
  </Panel>
</UserControl>

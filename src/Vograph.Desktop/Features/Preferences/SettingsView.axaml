<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vograph.Desktop.Controls"
             xmlns:loc="using:Vograph.Desktop.Services"
             xmlns:st="using:Vograph.Desktop.Features.Preferences"
             xmlns:account="using:Vograph.Desktop.Features.Account"
             xmlns:domain="using:Zapara.Client.Domain"
             x:Class="Vograph.Desktop.Features.Preferences.SettingsView"
             x:DataType="st:SettingsViewModel">
  <UserControl.Styles>
    <Style Selector="Grid.row"><Setter Property="Margin" Value="0,4" /></Style>
    <Style Selector="Grid.row > TextBlock"><Setter Property="VerticalAlignment" Value="Center" /></Style>
    <!-- Tabular figures in the notification time boxes, same as the .tnum TextBlocks elsewhere. -->
    <Style Selector="TextBox.tnum"><Setter Property="FontFeatures" Value="tnum" /></Style>
    <Style Selector="Expander.settings-row">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="32,26" Spacing="6" MaxWidth="720" HorizontalAlignment="Left">
      <TextBlock Classes="display" Text="{Binding Title}" />
      <Border Height="1" Background="{DynamicResource Brush.Line}" Margin="0,0,0,2" />
      <Expander Classes="settings-row" AutomationProperties.AutomationId="Settings.AccountSection">
        <Expander.Header>
          <StackPanel Orientation="Horizontal" Spacing="10" MinHeight="56">
            <Border Background="{DynamicResource Brush.Chip}" CornerRadius="8" Width="36" Height="36" VerticalAlignment="Center">
              <c:Icon Data="{StaticResource Icon.Users}" Size="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="Аккаунт" FontWeight="Medium" />
              <TextBlock Classes="muted caption" Text="{Binding AccountPanel.Status}" TextTrimming="CharacterEllipsis" MaxWidth="550" />
            </StackPanel>
          </StackPanel>
        </Expander.Header>
        <account:AccountPanelView DataContext="{Binding AccountPanel}" />
      </Expander>
      <TextBlock Classes="subject" Text="Основное" Margin="0,8,0,0" />


      <!-- Schedule -->
      <Expander Classes="settings-row" AutomationProperties.AutomationId="Settings.StudySection">
        <Expander.Header>
          <StackPanel Orientation="Horizontal" Spacing="10" MinHeight="56">
            <Border Background="{DynamicResource Brush.Chip}" CornerRadius="8" Width="36" Height="36" VerticalAlignment="Center"><c:Icon Data="{StaticResource Icon.Calendar}" Size="20" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            <StackPanel Spacing="2" VerticalAlignment="Center"><TextBlock Text="Учёба" FontWeight="Medium" /><TextBlock Classes="muted caption" Text="{Binding GroupName}" /></StackPanel>
          </StackPanel>
        </Expander.Header>
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="micro" Text="{loc:TU setSchedule}" />
          <Grid Classes="row" ColumnDefinitions="200,*">
            <TextBlock Text="{loc:T myGroup}" />
            <Button Grid.Column="1" HorizontalAlignment="Left" Command="{Binding ChangeGroupCommand}"
                    AutomationProperties.AutomationId="Settings.ChangeGroup" AutomationProperties.Name="{Binding GroupName}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding GroupName}" FontWeight="SemiBold" />
                <TextBlock Classes="muted" Text="{loc:T setChange}" />
              </StackPanel>
            </Button>
          </Grid>
          <c:Switch Content="{loc:T invertParity}" IsChecked="{Binding ParityInvert}" AutomationProperties.AutomationId="Settings.ParityInvert" />
          <TextBlock Classes="faint caption" Text="{loc:T invertHint}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsRefreshing}" ToolTip.Tip="{loc:T refreshTip}"
                    AutomationProperties.AutomationId="Settings.Refresh" AutomationProperties.Name="{loc:T refresh}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <c:Icon Data="{StaticResource Icon.Refresh}" Size="14" />
                <TextBlock Text="{loc:T refresh}" />
              </StackPanel>
            </Button>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Classes="muted caption" Text="{Binding UpdatedText}" />
              <TextBlock Classes="faint caption" Text="{Binding AutoCheckText}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>
      </Expander>

      <!-- Appearance -->
      <Expander Classes="settings-row" AutomationProperties.AutomationId="Settings.AppearanceSection">
        <Expander.Header>
          <StackPanel Orientation="Horizontal" Spacing="10" MinHeight="56">
            <Border Background="{DynamicResource Brush.Chip}" CornerRadius="8" Width="36" Height="36" VerticalAlignment="Center"><c:Icon Data="{StaticResource Icon.Sun}" Size="20" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            <StackPanel Spacing="2" VerticalAlignment="Center"><TextBlock Text="Оформление" FontWeight="Medium" /><TextBlock Classes="muted caption" Text="{Binding ThemeSummary}" /></StackPanel>
          </StackPanel>
        </Expander.Header>
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="micro" Text="{loc:TU setAppearance}" />
          <Grid Classes="row" ColumnDefinitions="200,*">
            <TextBlock Text="{loc:T setTheme}" />
            <c:SegmentedControl Name="SettingsTheme" Grid.Column="1" Items="{Binding ThemeItems}" SelectedIndex="{Binding ThemeIndex}" />
          </Grid>
          <c:Switch Content="{loc:T setCompactSidebar}" IsChecked="{Binding CompactSidebar}" AutomationProperties.AutomationId="Settings.CompactSidebar" />
          <c:Switch Content="{loc:T setAnimations}" IsChecked="{Binding Animations}" AutomationProperties.AutomationId="Settings.Animations" />
        </StackPanel>
      </Border>
      </Expander>

      <!-- Notifications -->
      <Expander Classes="settings-row" AutomationProperties.AutomationId="Settings.NotificationsSection">
        <Expander.Header>
          <StackPanel Orientation="Horizontal" Spacing="10" MinHeight="56">
            <Border Background="{DynamicResource Brush.Chip}" CornerRadius="8" Width="36" Height="36" VerticalAlignment="Center"><c:Icon Data="{StaticResource Icon.Bell}" Size="20" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            <StackPanel Spacing="2" VerticalAlignment="Center"><TextBlock Text="Уведомления" FontWeight="Medium" /><TextBlock Classes="muted caption" Text="{Binding NotificationSummary}" /></StackPanel>
          </StackPanel>
        </Expander.Header>
      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="micro" Text="{loc:TU setNotifications}" />
          <c:Switch Content="{loc:T notifEnabled}" IsChecked="{Binding NotificationsEnabled}" AutomationProperties.AutomationId="Settings.NotifyEnabled" />
          <StackPanel Spacing="4" IsEnabled="{Binding NotificationsEnabled}">
            <Grid Classes="row" ColumnDefinitions="200,*">
              <TextBlock Text="{loc:T notifTime1Label}" />
              <TextBox Grid.Column="1" MaxWidth="120" HorizontalAlignment="Left" Text="{Binding NotifyTime1}" Classes="tnum" AutomationProperties.AutomationId="Settings.NotifyTime1" />
            </Grid>
            <Grid Classes="row" ColumnDefinitions="200,*">
              <TextBlock Text="{loc:T notifTime2Label}" />
              <TextBox Grid.Column="1" MaxWidth="120" HorizontalAlignment="Left" Text="{Binding NotifyTime2}" Classes="tnum" AutomationProperties.AutomationId="Settings.NotifyTime2" />
            </Grid>
            <Button Classes="primary" Content="{loc:T notifSave}" Command="{Binding SaveTimesCommand}" HorizontalAlignment="Left" AutomationProperties.AutomationId="Settings.SaveTimes" />
          </StackPanel>
          <Button Command="{Binding TestNotificationCommand}" HorizontalAlignment="Left"
                  AutomationProperties.AutomationId="Settings.TestNotification" AutomationProperties.Name="{loc:T notifTest}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:Icon Data="{StaticResource Icon.Bell}" Size="14" />
              <TextBlock Text="{loc:T notifTest}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>
      </Expander>

      <TextBlock Classes="subject" Text="Сервис" Margin="0,8,0,0" />
      <!-- Sync -->
      <Expander Classes="settings-row" IsVisible="{Binding LegacyTransferAvailable}" AutomationProperties.AutomationId="Settings.SyncSection">
        <Expander.Header>
          <StackPanel Orientation="Horizontal" Spacing="10" MinHeight="56">
            <Border Background="{DynamicResource Brush.Chip}" CornerRadius="8" Width="36" Height="36" VerticalAlignment="Center"><c:Icon Data="{StaticResource Icon.Refresh}" Size="20" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            <StackPanel Spacing="2" VerticalAlignment="Center"><TextBlock Text="Перенос данных" FontWeight="Medium" /><TextBlock Classes="muted caption" Text="Экспорт и импорт" /></StackPanel>
          </StackPanel>
        </Expander.Header>
      <Border Classes="card" IsVisible="{Binding LegacyTransferAvailable}">
        <StackPanel Spacing="10">
          <TextBlock Classes="micro" Text="{loc:TU setSync}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Command="{Binding ExportCommand}" AutomationProperties.AutomationId="Settings.Export" AutomationProperties.Name="{loc:T syncExport}">
              <StackPanel Orientation="Horizontal" Spacing="6"><c:Icon Data="{StaticResource Icon.Download}" Size="14" /><TextBlock Text="{loc:T syncExport}" /></StackPanel>
            </Button>
            <Button Command="{Binding ImportCommand}" AutomationProperties.AutomationId="Settings.Import" AutomationProperties.Name="{loc:T syncImport}">
              <StackPanel Orientation="Horizontal" Spacing="6"><c:Icon Data="{StaticResource Icon.Upload}" Size="14" /><TextBlock Text="{loc:T syncImport}" /></StackPanel>
            </Button>
            <Button Command="{Binding ToggleQrCommand}" AutomationProperties.AutomationId="Settings.Qr" AutomationProperties.Name="{loc:T syncShowQr}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <c:Icon Data="{StaticResource Icon.Qr}" Size="14" />
                <TextBlock Text="{loc:T syncShowQr}" IsVisible="{Binding !QrVisible}" />
                <TextBlock Text="{loc:T syncHideQr}" IsVisible="{Binding QrVisible}" />
              </StackPanel>
            </Button>
          </StackPanel>
          <StackPanel Spacing="8" IsVisible="{Binding QrVisible}">
            <!-- Brush.QrPaper is white in both themes: a scanner cannot read a QR code off a dark backing. -->
            <Border Background="{DynamicResource Brush.QrPaper}" CornerRadius="{DynamicResource Radius.Control}" Padding="12" HorizontalAlignment="Left">
              <Image Source="{Binding QrImage}" Width="220" Height="220" />
            </Border>
            <TextBlock Classes="muted caption" Text="{Binding QrHint}" TextWrapping="Wrap" />
          </StackPanel>
          <c:Switch Content="{loc:T syncLan}" IsChecked="{Binding LanSync}" AutomationProperties.AutomationId="Settings.LanSync" />
          <TextBlock Classes="muted caption" Text="{Binding LanAddress}" IsVisible="{Binding LanAddress, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     AutomationProperties.AutomationId="Settings.LanAddress" />
        </StackPanel>
      </Border>
      </Expander>

      <!-- Updates -->
      <Expander Classes="settings-row" AutomationProperties.AutomationId="Settings.UpdatesSection">
        <Expander.Header>
          <StackPanel Orientation="Horizontal" Spacing="10" MinHeight="56">
            <Border Background="{DynamicResource Brush.Chip}" CornerRadius="8" Width="36" Height="36" VerticalAlignment="Center"><c:Icon Data="{StaticResource Icon.Refresh}" Size="20" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            <StackPanel Spacing="2" VerticalAlignment="Center"><TextBlock Text="Обновления" FontWeight="Medium" /><TextBlock Classes="muted caption" Text="{Binding Updates.StatusText}" TextTrimming="CharacterEllipsis" MaxWidth="550" /></StackPanel>
          </StackPanel>
        </Expander.Header>
      <Border Classes="card">
        <StackPanel Spacing="10" DataContext="{Binding Updates}" x:DataType="st:UpdateCheckViewModel">
          <TextBlock Classes="micro" Text="{loc:TU setUpdates}" />
          <c:Switch Content="{loc:T autoUpdate}" IsChecked="{Binding AutoUpdate}" AutomationProperties.AutomationId="Updates.AutoUpdate" />
          <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Classes.bad="{Binding IsFailed}" AutomationProperties.AutomationId="Updates.Status" />
          <TextBlock Classes="muted caption" Text="{Binding PublishedText}" IsVisible="{Binding PublishedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <Border Height="6" Width="320" HorizontalAlignment="Left" CornerRadius="3" Background="{DynamicResource Brush.Chip}" IsVisible="{Binding IsDownloading}" ClipToBounds="True">
            <Border HorizontalAlignment="Left" CornerRadius="3" Background="{DynamicResource Brush.Accent}"
                    Width="{Binding Progress, Converter={x:Static st:UpdateConverters.ProgressWidth}}" IsVisible="{Binding HasDeterminateProgress}" />
          </Border>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="primary" Content="{loc:T updInstall}" Command="{Binding InstallCommand}" IsVisible="{Binding CanInstall}" AutomationProperties.AutomationId="Updates.Install" />
            <Button Content="{loc:T updCheck}" Command="{Binding CheckCommand}" IsEnabled="{Binding !IsChecking}" AutomationProperties.AutomationId="Updates.Check" />
            <Button Classes="link" Content="{loc:T updInBrowser}" Command="{Binding OpenReleasesCommand}" AutomationProperties.AutomationId="Updates.Releases" />
          </StackPanel>
        </StackPanel>
      </Border>
      </Expander>


      <Expander Classes="settings-row" AutomationProperties.AutomationId="Settings.SupportSection">
        <Expander.Header>
          <StackPanel Orientation="Horizontal" Spacing="10" MinHeight="56">
            <Border Background="{DynamicResource Brush.Chip}" CornerRadius="8" Width="36" Height="36" VerticalAlignment="Center">
              <c:Icon Data="{StaticResource Icon.File}" Size="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="Помощь" FontWeight="Medium" />
              <TextBlock Classes="muted caption" Text="Поддержка и документы" />
            </StackPanel>
          </StackPanel>
        </Expander.Header>
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="micro" Text="Поддержка" />
          <TextBlock TextWrapping="Wrap" Text="Сообщить о баге или ошибке. Войдите в аккаунт, чтобы отправить сообщение и увидеть ответ." />
          <TextBox Text="{Binding ReportSubject}" PlaceholderText="Тема" MinHeight="48" AutomationProperties.AutomationId="Settings.ReportSubject" />
          <TextBox Text="{Binding ReportBody}" PlaceholderText="Что случилось" AcceptsReturn="True" MinHeight="96" TextWrapping="Wrap" AutomationProperties.AutomationId="Settings.ReportBody" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Фото" MinHeight="48" MinWidth="48" Command="{Binding PickReportPhotoCommand}" AutomationProperties.AutomationId="Settings.ReportPhoto" />
            <Button Content="Лог" MinHeight="48" MinWidth="48" Command="{Binding PickReportLogCommand}" AutomationProperties.AutomationId="Settings.ReportLog" />
          </StackPanel>
          <TextBlock TextWrapping="Wrap" Text="До трёх фотографий JPEG, PNG или WebP, до 4 МиБ. До трёх логов .txt или .log, до 512 КиБ." />
          <TextBlock Text="{Binding ReportFilesText}" TextWrapping="Wrap" />
          <Button Content="Сообщить о баге" HorizontalAlignment="Left" MinHeight="48" Command="{Binding SendReportCommand}" AutomationProperties.AutomationId="Settings.Report" />
          <TextBlock Text="{Binding ReportNote}" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding ReportMessages}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="domain:SupportNote">
                <TextBlock Text="{Binding Body}" TextWrapping="Wrap" Margin="0,4" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      </Expander>

      <!-- About -->
      <Expander Classes="settings-row" AutomationProperties.AutomationId="Settings.AboutSection">
        <Expander.Header>
          <StackPanel Orientation="Horizontal" Spacing="10" MinHeight="56">
            <Border Background="{DynamicResource Brush.Chip}" CornerRadius="8" Width="36" Height="36" VerticalAlignment="Center"><c:Icon Data="{StaticResource Icon.File}" Size="20" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            <StackPanel Spacing="2" VerticalAlignment="Center"><TextBlock Text="О приложении" FontWeight="Medium" /><TextBlock Classes="muted caption" Text="{Binding VersionText}" /></StackPanel>
          </StackPanel>
        </Expander.Header>
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="micro" Text="{loc:TU setAbout}" />
          <TextBlock Text="{Binding VersionText}" AutomationProperties.AutomationId="About.Version" />
          <Button Classes="link" Content="{loc:T setReleases}" Command="{Binding OpenReleasesCommand}" HorizontalAlignment="Left" AutomationProperties.AutomationId="About.Releases" />
          <TextBlock Classes="muted caption" Text="{loc:T setSources}" Margin="0,6,0,0" />
          <Button Classes="link" Content="{loc:T setSourceTimetable}" Command="{Binding OpenTimetableSourceCommand}" HorizontalAlignment="Left" />
          <Button Classes="link" Content="{loc:T setSourceMaps}" Command="{Binding OpenMapsSourceCommand}" HorizontalAlignment="Left" />
          <Button Classes="ghost" HorizontalAlignment="Left" Command="{Binding OpenDataFolderCommand}" Margin="0,6,0,0"
                  AutomationProperties.AutomationId="About.DataFolder" AutomationProperties.Name="{loc:T setDataFolder}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:Icon Data="{StaticResource Icon.Folder}" Size="14" />
              <TextBlock Text="{loc:T setDataFolder}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>

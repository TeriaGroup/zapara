<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vograph.Desktop.Controls"
             xmlns:loc="using:Vograph.Desktop.Services"
             xmlns:w="using:Vograph.Desktop.Features.Week"
             x:Class="Vograph.Desktop.Features.Week.WeekView"
             x:DataType="w:WeekViewModel">
  <ScrollViewer>
    <StackPanel Margin="32,26" Spacing="12">
      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
        <StackPanel Margin="0,0,16,0">
          <TextBlock Classes="display" Text="{Binding Title}" />
          <TextBlock Classes="muted" Text="{Binding Subtitle}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <c:SegmentedControl Grid.Column="1" VerticalAlignment="Bottom" Items="{Binding SegmentItems}" SelectedIndex="{Binding ParityIndex}" />
      </Grid>

      <ItemsControl ItemsSource="{Binding Days}" IsVisible="{Binding HasGroup}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="w:WeekDayViewModel">
            <!-- A Button so the whole card is one click target and keyboard-focusable. -->
            <Button Classes="ghost weekday" Padding="0" Margin="0,0,12,12" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    Command="{Binding OpenCommand}" ToolTip.Tip="{loc:T weekOpenDayTip}">
              <Border Classes="card hoverable" Classes.next="{Binding IsToday}" MinHeight="150">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="subject" Text="{Binding Title}" />
                    <TextBlock Grid.Column="1" Classes="faint tnum" FontSize="12" Text="{Binding DateText}" VerticalAlignment="Center" />
                  </Grid>
                  <TextBlock Classes="faint" Text="{loc:T noLessons}" IsVisible="{Binding IsEmpty}" />
                  <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="w:WeekRow">
                        <Grid ColumnDefinitions="48,*,Auto">
                          <TextBlock Classes="tnum" Text="{Binding Time}" FontWeight="Medium" VerticalAlignment="Center" />
                          <WrapPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                            <Border Classes="chip type" Margin="6,0,0,0" VerticalAlignment="Center"
                                    IsVisible="{Binding TypeLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                              <TextBlock Text="{Binding TypeLabel}" />
                            </Border>
                          </WrapPanel>
                          <Border Grid.Column="2" Classes="chip" VerticalAlignment="Center">
                            <TextBlock Classes="tnum" Text="{Binding Room}" />
                          </Border>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <c:EmptyState IsVisible="{Binding !HasGroup}" Title="{loc:T noGroup}" Hint="{loc:T noGroupHint}" Icon="{StaticResource Icon.Week}" Margin="0,48,0,0" />
    </StackPanel>
  </ScrollViewer>
</UserControl>

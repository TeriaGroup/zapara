<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vograph.Desktop.Controls"
             xmlns:loc="using:Vograph.Desktop.Services"
             xmlns:s="using:Vograph.Desktop.Features.Schedule"
             x:Class="Vograph.Desktop.Features.Schedule.ScheduleView"
             x:DataType="s:ScheduleViewModel">
  <UserControl.Styles><Style Selector="TextBlock.done"><Setter Property="TextDecorations" Value="Strikethrough" /></Style><Style Selector="TextBlock.display"><Setter Property="FontSize" Value="22" /><Setter Property="FontWeight" Value="Medium" /></Style><Style Selector="TextBlock.subject"><Setter Property="FontSize" Value="17" /><Setter Property="FontWeight" Value="Medium" /></Style></UserControl.Styles>
  <Grid RowDefinitions="*,Auto"><ScrollViewer x:Name="ScheduleScroll" Grid.Row="0" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="1280" Margin="24" Spacing="12">

      <Grid ColumnDefinitions="*" RowDefinitions="Auto,Auto,Auto" Margin="0,0,0,8" MinWidth="0">
        <!-- Subtitle is its own row so the day controls cannot squeeze "4 пары" onto a leftover line. -->
        <TextBlock Grid.Row="0" Classes="display" Text="{loc:T navSchedule}" TextWrapping="Wrap" VerticalAlignment="Center"
                   Margin="0,0,16,0" AutomationProperties.AutomationId="Schedule.Title" />
        <TextBlock Grid.Row="1" Classes="muted" Text="{Binding DayLine}" Margin="0,4,0,0" TextWrapping="Wrap"
                   AutomationProperties.AutomationId="Schedule.Subtitle" />
        <!-- #19 (D-03): тулбар в одну строку — ‹ день › «К сегодня», дата, поиск и «⋯». -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <Button Classes="ghost icon" Classes.on="{Binding ShowLessonSearch}" Command="{Binding ToggleLessonSearchCommand}"
                        ToolTip.Tip="Поиск по дню" AutomationProperties.Name="Поиск по дню" AutomationProperties.AutomationId="Schedule.Search">
            <c:Icon Data="{StaticResource Icon.Search}" />
          </Button>
          <Button Classes="ghost icon" ToolTip.Tip="Ещё" AutomationProperties.Name="Ещё действия с днём" AutomationProperties.AutomationId="Schedule.More">
            <c:Icon Data="{StaticResource Icon.More}" Size="20" Foreground="{DynamicResource Brush.Text1}" />
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem Header="Копировать день" Command="{Binding CopyDayCommand}" />
                <MenuItem Header="{loc:T toDeadlines}" Command="{Binding JumpDeadlinesCommand}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
        <WrapPanel ItemSpacing="8" LineSpacing="8" VerticalAlignment="Center">
          <Button Classes="ghost icon" Command="{Binding PrevDayCommand}" ToolTip.Tip="{loc:T prevDay}"
                  AutomationProperties.AutomationId="Schedule.Prev" AutomationProperties.Name="{loc:T prevDay}">
            <c:Icon Data="{StaticResource Icon.ChevronLeft}" />
          </Button>
          <c:SegmentedControl Name="ScheduleSegment" Items="{Binding SegmentItems}" SelectedIndex="{Binding SegmentIndex}" />
          <Button Classes="ghost icon" Command="{Binding NextDayCommand}" ToolTip.Tip="{loc:T nextDay}"
                  AutomationProperties.AutomationId="Schedule.Next" AutomationProperties.Name="{loc:T nextDay}">
            <c:Icon Data="{StaticResource Icon.ChevronRight}" />
          </Button>
          <Button Classes="pill" Command="{Binding GoTodayCommand}" Content="{loc:T goToday}" IsVisible="{Binding ShowGoToday}"
                  AutomationProperties.AutomationId="Schedule.Today" />
          <CalendarDatePicker SelectedDate="{Binding CalendarDate}" MinHeight="48" Width="180"
                              AutomationProperties.Name="Выбрать дату расписания" AutomationProperties.AutomationId="Schedule.Calendar" />
        </WrapPanel>
        </DockPanel>
      </Grid>
      <TextBlock Text="Загружаем выбранный день…" IsVisible="{Binding ShowFirstDayLoading}" />
      <TextBlock Text="{Binding ScheduleLoadError}" IsVisible="{Binding ScheduleLoadError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />

      <TextBox Text="{Binding LessonSearch, Mode=TwoWay}" PlaceholderText="Предмет, преподаватель или аудитория этого дня" AutomationProperties.Name="Поиск по выбранному дню" IsVisible="{Binding ShowLessonSearch}" />
      <WrapPanel ItemSpacing="8" IsVisible="{Binding HasLessonSearch}"><Button Content="Очистить поиск" Command="{Binding ClearLessonSearchCommand}" /><TextBlock Text="Ничего не найдено в выбранном дне" IsVisible="{Binding NoLessonMatches}" VerticalAlignment="Center" /></WrapPanel>
      <ItemsControl ItemsSource="{Binding MatchingLessons}" IsVisible="{Binding HasLessonSearch}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="s:LessonRowViewModel"><Button Classes="ghost" Command="{Binding $parent[UserControl].((s:ScheduleViewModel)DataContext).OpenSearchResultCommand}" CommandParameter="{Binding}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding TimeStart}" /><TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" /><TextBlock Classes="muted caption" Text="{Binding RoomText}" /></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <Grid Name="PlannerColumns" ColumnDefinitions="*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="12"><StackPanel Name="PlannerDates">      <ItemsControl ItemsSource="{Binding DateChoices}" Margin="0,0,0,8">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="8" LineSpacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="s:PlannerDayChoice">
            <c:SelectionButton IsChecked="{Binding IsSelected,Mode=OneWay}" Classes.secondary="{Binding !IsSelected}" Classes.primary="{Binding IsSelected}" Command="{Binding SelectCommand}"
                    Padding="10,8" MinWidth="72" AutomationProperties.Name="{Binding AccessibleName}">
              <StackPanel Spacing="2" HorizontalAlignment="Center">
                <TextBlock Text="{Binding DayLabel}" FontSize="12" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding DateLabel}" FontSize="17" FontWeight="Medium" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Workload}" FontSize="12" HorizontalAlignment="Center" />
              </StackPanel>
            </c:SelectionButton>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
</StackPanel><StackPanel Name="PlannerMain" Grid.Row="1" Spacing="12">      <!-- #19 (D-05): одна строка метаданных дня вместо «Занятия …» и «С … до … · перерывы: …». -->
      <TextBlock Classes="muted" Text="{Binding DayMeta}" IsVisible="{Binding HasDayMeta}" AutomationProperties.AutomationId="Schedule.DayMeta" />
      <TextBlock Classes="muted caption" Text="{Binding SourceSummary}" TextWrapping="Wrap" />
      <StackPanel Spacing="6" IsVisible="{Binding HasOverlaps}">
        <TextBlock Text="Пересекаются пары:" Classes="subject" />
        <ItemsControl ItemsSource="{Binding Overlaps}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="s:ScheduleOverlap">
          <StackPanel Spacing="3"><TextBlock Text="{Binding Caption}" TextWrapping="Wrap" /><WrapPanel ItemSpacing="8"><Button Content="Первая пара" Command="{Binding $parent[UserControl].((s:ScheduleViewModel)DataContext).OpenOverlapFirstCommand}" CommandParameter="{Binding}" /><Button Content="Вторая пара" Command="{Binding $parent[UserControl].((s:ScheduleViewModel)DataContext).OpenOverlapSecondCommand}" CommandParameter="{Binding}" /></WrapPanel></StackPanel>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel>
      <StackPanel Spacing="6" IsVisible="{Binding HasTransferWarnings}">
        <TextBlock Classes="subject" Text="Переходы между парами" />
        <ItemsControl ItemsSource="{Binding TransferWarnings}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel>
      <TextBlock Classes="subject" Text="{Binding DayPriorityCaption}" IsVisible="{Binding ShowDayState}" />
      <!-- #19 (D-05): под «Сейчас / Следующая пара» — сама пара; нажатие раскрывает её карточку в списке. -->
      <Panel IsVisible="{Binding HasHeroLesson}">
      <Button Name="ScheduleHero" Classes="ghost" Padding="0" DataContext="{Binding HeroLesson}" x:DataType="s:LessonRowViewModel"
              Command="{Binding FocusInDayCommand}"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
              AutomationProperties.AutomationId="Schedule.Hero" AutomationProperties.Name="{Binding DisplayName}">
        <Border Classes="card next" Padding="16,12">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <StackPanel VerticalAlignment="Center" Spacing="2">
              <TextBlock Classes="subject tnum" Text="{Binding TimeStart}" />
              <TextBlock Classes="muted caption tnum" Text="{Binding TimeEnd}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center" Spacing="2">
              <TextBlock Classes="subject" Text="{Binding DisplayName}" TextWrapping="Wrap" />
              <TextBlock Classes="muted caption" Text="{Binding TeacherLine}" TextWrapping="Wrap" />
            </StackPanel>
            <Border Grid.Column="2" Classes="chip room" VerticalAlignment="Center"
                    IsVisible="{Binding RoomText, Converter={x:Static loc:RoomChip.Visible}}">
              <TextBlock Classes="tnum" Text="{Binding RoomText}" />
            </Border>
          </Grid>
        </Border>
      </Button>
      </Panel>
      <TextBlock Classes="muted caption" Text="{Binding DeadlineAttention}" IsVisible="{Binding HasDeadlineAttention}" />
      <TextBlock Classes="muted caption" Text="{Binding LessonJumpStatus}" IsVisible="{Binding LessonJumpStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <c:Switch Content="Осталось сегодня" IsChecked="{Binding RemainingToday}" IsVisible="{Binding CanFilterRemainingToday}" />
      <TextBlock Text="На сегодня пары закончились" IsVisible="{Binding RemainingEmpty}" Classes="muted caption" />

      <Border Height="1" Background="{DynamicResource Brush.Line}" Margin="0,0,0,6" />

      <!-- One panel for the whole day's content: ScheduleView.axaml.cs crossfades and slides it on a day change. -->
      <Panel x:Name="Body">
        <ItemsControl ItemsSource="{Binding VisibleDayRows}" c:Appear.CascadeHost="True">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.DataTemplates>
            <DataTemplate DataType="{x:Type s:LessonRowViewModel}" x:DataType="s:LessonRowViewModel">
              <s:LessonCardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type s:PlannerBreak}" x:DataType="s:PlannerBreak">
              <Border Padding="12,8" Background="{DynamicResource Brush.Surface}" CornerRadius="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="muted caption" Text="{Binding TimeLabel}" TextWrapping="Wrap" VerticalAlignment="Center" />
                  <Border Grid.Column="1" Margin="8,0,0,0" Padding="8,4" Background="{DynamicResource Brush.Chip}" CornerRadius="6">
                    <TextBlock Classes="muted caption" Text="{Binding Duration}" />
                  </Border>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.DataTemplates>
        </ItemsControl>

        <StackPanel IsVisible="{Binding IsEmpty}" Spacing="12" Margin="0,24,0,0">
          <c:EmptyState Title="{Binding EmptyTitle}" Hint="{Binding EmptyHint}" Icon="{StaticResource Icon.Calendar}"
                        ActionText="{Binding EmptyAction}" Command="{Binding ChangeGroupCommand}" AutomationProperties.AutomationId="Schedule.Empty" />
          <StackPanel IsVisible="{Binding IsUnavailable}" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <Button Classes="primary" Content="{loc:T retry}" Command="{Binding RetryCommand}" />
            <Button Classes="pill" Content="{loc:T groupPickTitle}" Command="{Binding ChangeGroupCommand}" />
          </StackPanel>
        </StackPanel>
      </Panel>
      <Button Classes="secondary" Command="{Binding OpenNextStudyDayCommand}" IsVisible="{Binding HasNextStudyDate}" HorizontalAlignment="Left"><TextBlock Text="{Binding NextStudyCaption}" TextWrapping="Wrap" /></Button>
</StackPanel>      <Border Name="PlannerDeadlines" Grid.Row="2" Classes="card" Focusable="True" VerticalAlignment="Top" AutomationProperties.Name="Ближайшие сроки"><StackPanel Spacing="8">
        <TextBlock Classes="subject" Text="{Binding DeadlineTitle}" />
        <ItemsControl ItemsSource="{Binding Deadlines}" IsVisible="{Binding HasDeadlineRows}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="s:PlannerDeadlineRow">
          <Grid ColumnDefinitions="48,*" Margin="0,4">
            <CheckBox IsChecked="{Binding Done,Mode=OneWay}" Command="{Binding ToggleCommand}" AutomationProperties.Name="{Binding CompletionCaption}" VerticalAlignment="Top" />
            <StackPanel Grid.Column="1" Spacing="4">
              <Button Classes="ghost" Command="{Binding OpenCommand}" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch"><TextBlock Text="{Binding Text}" TextWrapping="Wrap" Classes.done="{Binding Done}" /></Button>
              <TextBlock Classes="muted caption" Text="{Binding Subject}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Deadline}" FontWeight="Medium" />
              <TextBlock Classes="muted caption" Text="Выполнено" IsVisible="{Binding Done}" />
              <Button Content="Обсудить задание" Classes="ghost" Command="{Binding DiscussCommand}" HorizontalAlignment="Left" />
            </StackPanel>
          </Grid>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <WrapPanel ItemSpacing="8" IsVisible="{Binding HasDeadlineFeedback}"><TextBlock Text="{Binding DeadlineFeedback}" VerticalAlignment="Center" /><Button Content="Отменить" Command="{Binding UndoDeadlineCommand}" /></WrapPanel>
      </StackPanel></Border>
</Grid>
    </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="1" IsVisible="{Binding HasSubgroupUndo}" Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0" Padding="24,8">
    <WrapPanel ItemSpacing="12" HorizontalAlignment="Center"><TextBlock Text="{Binding SubgroupUndoCaption}" VerticalAlignment="Center" /><Button Content="Отменить выбор" Command="{Binding UndoSubgroupCommand}" /></WrapPanel>
  </Border></Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vograph.Desktop.Controls"
             xmlns:loc="using:Vograph.Desktop.Services"
             xmlns:s="using:Vograph.Desktop.Features.Schedule"
             x:Class="Vograph.Desktop.Features.Schedule.ScheduleView"
             x:DataType="s:ScheduleViewModel">
  <UserControl.Styles><Style Selector="TextBlock.done"><Setter Property="TextDecorations" Value="Strikethrough" /></Style><Style Selector="TextBlock.display"><Setter Property="FontSize" Value="22" /><Setter Property="FontWeight" Value="Medium" /></Style><Style Selector="TextBlock.subject"><Setter Property="FontSize" Value="17" /><Setter Property="FontWeight" Value="Medium" /></Style></UserControl.Styles>
  <Grid RowDefinitions="*,Auto"><ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="1280" Margin="24" Spacing="12">

      <Grid ColumnDefinitions="*" RowDefinitions="Auto,Auto,Auto" Margin="0,0,0,8" MinWidth="0">
        <!-- Subtitle is its own row so the day controls cannot squeeze "4 пары" onto a leftover line. -->
        <TextBlock Grid.Row="0" Classes="display" Text="{Binding Title}" TextWrapping="Wrap" VerticalAlignment="Center"
                   Margin="0,0,16,0" AutomationProperties.AutomationId="Schedule.Title" />
        <TextBlock Grid.Row="1" Classes="muted" Text="{Binding Subtitle}" Margin="0,4,0,0" TextWrapping="Wrap"
                   AutomationProperties.AutomationId="Schedule.Subtitle" />
        <WrapPanel Grid.Row="2" ItemSpacing="8" LineSpacing="8" Margin="0,12,0,0" VerticalAlignment="Center">
          <Button Classes="ghost icon" Command="{Binding PrevDayCommand}" ToolTip.Tip="{loc:T prevDay}"
                  AutomationProperties.AutomationId="Schedule.Prev" AutomationProperties.Name="{loc:T prevDay}">
            <c:Icon Data="{StaticResource Icon.ChevronLeft}" />
          </Button>
          <c:SegmentedControl Name="ScheduleSegment" Items="{Binding SegmentItems}" SelectedIndex="{Binding SegmentIndex}" />
          <Button Classes="ghost icon" Command="{Binding NextDayCommand}" ToolTip.Tip="{loc:T nextDay}"
                  AutomationProperties.AutomationId="Schedule.Next" AutomationProperties.Name="{loc:T nextDay}">
            <c:Icon Data="{StaticResource Icon.ChevronRight}" />
          </Button>
          <Button Classes="pill" Command="{Binding GoTodayCommand}" Content="{loc:T goToday}" IsVisible="{Binding ShowGoToday}"
                  AutomationProperties.AutomationId="Schedule.Today" />
          <CalendarDatePicker SelectedDate="{Binding CalendarDate}" MinHeight="48" Width="180"
                              AutomationProperties.Name="Выбрать дату расписания" AutomationProperties.AutomationId="Schedule.Calendar" />
        </WrapPanel>
      </Grid>

      <Grid Name="PlannerColumns" ColumnDefinitions="*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="12"><StackPanel Name="PlannerDates">      <ItemsControl ItemsSource="{Binding DateChoices}" Margin="0,0,0,8">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="8" LineSpacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="s:PlannerDayChoice">
            <c:SelectionButton IsChecked="{Binding IsSelected,Mode=OneWay}" Classes="secondary" Classes.primary="{Binding IsSelected}" Command="{Binding SelectCommand}"
                    Padding="10,8" MinWidth="72" AutomationProperties.Name="{Binding AccessibleName}">
              <StackPanel Spacing="2" HorizontalAlignment="Center">
                <TextBlock Text="{Binding DayLabel}" FontSize="12" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding DateLabel}" FontSize="17" FontWeight="Medium" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Workload}" FontSize="12" HorizontalAlignment="Center" />
              </StackPanel>
            </c:SelectionButton>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
</StackPanel><StackPanel Name="PlannerMain" Grid.Row="1" Spacing="12">      <TextBlock Classes="muted caption" Text="{Binding DaySummary}" IsVisible="{Binding DaySummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Classes="muted caption" Text="{Binding SourceSummary}" TextWrapping="Wrap" />
      <StackPanel Spacing="6" IsVisible="{Binding HasOverlaps}">
        <TextBlock Text="Пересекаются пары:" Classes="subject" />
        <ItemsControl ItemsSource="{Binding Overlaps}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="s:ScheduleOverlap">
          <Button Content="{Binding Caption}" Click="OnOverlapClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel>
      <TextBlock Classes="subject" Text="{Binding DayPriorityCaption}" IsVisible="{Binding ShowDayState}" />

      <Border Height="1" Background="{DynamicResource Brush.Line}" Margin="0,0,0,6" />

      <!-- One panel for the whole day's content: ScheduleView.axaml.cs crossfades and slides it on a day change. -->
      <Panel x:Name="Body">
        <ItemsControl ItemsSource="{Binding DayRows}" c:Appear.CascadeHost="True">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.DataTemplates>
            <DataTemplate DataType="{x:Type s:LessonRowViewModel}" x:DataType="s:LessonRowViewModel">
              <s:LessonCardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type s:PlannerBreak}" x:DataType="s:PlannerBreak">
              <Border Padding="12,8" Background="{DynamicResource Brush.Surface}" CornerRadius="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="muted caption" Text="{Binding TimeLabel}" TextWrapping="Wrap" VerticalAlignment="Center" />
                  <Border Grid.Column="1" Margin="8,0,0,0" Padding="8,4" Background="{DynamicResource Brush.Chip}" CornerRadius="6">
                    <TextBlock Classes="muted caption" Text="{Binding Duration}" />
                  </Border>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.DataTemplates>
        </ItemsControl>

        <StackPanel IsVisible="{Binding IsEmpty}" Spacing="12" Margin="0,24,0,0">
          <c:EmptyState Title="{Binding EmptyTitle}" Hint="{Binding EmptyHint}" Icon="{StaticResource Icon.Calendar}" />
          <StackPanel IsVisible="{Binding IsUnavailable}" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <Button Classes="primary" Content="{loc:T retry}" Command="{Binding RetryCommand}" />
            <Button Classes="pill" Content="{loc:T groupPickTitle}" Command="{Binding ChangeGroupCommand}" />
          </StackPanel>
        </StackPanel>
      </Panel>
      <Button Classes="secondary" Command="{Binding OpenNextStudyDayCommand}" IsVisible="{Binding HasNextStudyDate}" HorizontalAlignment="Left"><TextBlock Text="{Binding NextStudyCaption}" TextWrapping="Wrap" /></Button>
</StackPanel>      <Border Name="PlannerDeadlines" Grid.Row="2" Classes="card"><StackPanel Spacing="8">
        <TextBlock Classes="subject" Text="{Binding DeadlineTitle}" />
        <ItemsControl ItemsSource="{Binding Deadlines}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="s:PlannerDeadlineRow">
          <Grid ColumnDefinitions="48,*" Margin="0,4">
            <CheckBox IsChecked="{Binding Done,Mode=OneWay}" Command="{Binding ToggleCommand}" AutomationProperties.Name="{Binding CompletionCaption}" VerticalAlignment="Top" />
            <StackPanel Grid.Column="1" Spacing="4">
              <Button Classes="ghost" Command="{Binding OpenCommand}" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch"><TextBlock Text="{Binding Text}" TextWrapping="Wrap" Classes.done="{Binding Done}" /></Button>
              <TextBlock Classes="muted caption" Text="{Binding Subject}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Deadline}" FontWeight="Medium" />
              <TextBlock Classes="muted caption" Text="Готово у меня" IsVisible="{Binding Done}" />
              <Button Content="Обсудить задание" Classes="ghost" Command="{Binding DiscussCommand}" HorizontalAlignment="Left" />
            </StackPanel>
          </Grid>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <WrapPanel ItemSpacing="8" IsVisible="{Binding HasDeadlineFeedback}"><TextBlock Text="{Binding DeadlineFeedback}" VerticalAlignment="Center" /><Button Content="Отменить" Command="{Binding UndoDeadlineCommand}" /></WrapPanel>
      </StackPanel></Border>
</Grid>
    </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="1" IsVisible="{Binding HasSubgroupUndo}" Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0" Padding="24,8">
    <WrapPanel ItemSpacing="12" HorizontalAlignment="Center"><TextBlock Text="{Binding SubgroupUndoCaption}" VerticalAlignment="Center" /><Button Content="Отменить выбор" Command="{Binding UndoSubgroupCommand}" /></WrapPanel>
  </Border></Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vograph.Desktop.Controls"
             xmlns:loc="using:Vograph.Desktop.Services"
             xmlns:s="using:Vograph.Desktop.Features.Schedule"
             x:Class="Vograph.Desktop.Features.Schedule.ScheduleView"
             x:DataType="s:ScheduleViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="760" Margin="32,26" Spacing="10">

      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,0,0,8" MinWidth="0">
        <!-- Subtitle is its own row so the day controls cannot squeeze "4 пары" onto a leftover line. -->
        <TextBlock Grid.Row="0" Classes="display" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                   Margin="0,0,16,0" AutomationProperties.AutomationId="Schedule.Title" />
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="muted" Text="{Binding Subtitle}" Margin="0,4,0,0" TextWrapping="Wrap"
                   AutomationProperties.AutomationId="Schedule.Subtitle" />
        <WrapPanel Grid.Row="0" Grid.Column="1" ItemSpacing="8" LineSpacing="8" VerticalAlignment="Center" HorizontalAlignment="Right">
          <Button Classes="round" Command="{Binding PrevDayCommand}" ToolTip.Tip="{loc:T prevDay}"
                  AutomationProperties.AutomationId="Schedule.Prev" AutomationProperties.Name="{loc:T prevDay}">
            <c:Icon Data="{StaticResource Icon.ChevronLeft}" />
          </Button>
          <c:SegmentedControl Name="ScheduleSegment" Items="{Binding SegmentItems}" SelectedIndex="{Binding SegmentIndex}" />
          <Button Classes="round" Command="{Binding NextDayCommand}" ToolTip.Tip="{loc:T nextDay}"
                  AutomationProperties.AutomationId="Schedule.Next" AutomationProperties.Name="{loc:T nextDay}">
            <c:Icon Data="{StaticResource Icon.ChevronRight}" />
          </Button>
          <Button Classes="pill" Command="{Binding GoTodayCommand}" Content="{loc:T goToday}" IsVisible="{Binding ShowGoToday}"
                  AutomationProperties.AutomationId="Schedule.Today" />
        </WrapPanel>
      </Grid>

      <!-- One panel for the whole day's content: ScheduleView.axaml.cs crossfades and slides it on a day change. -->
      <Panel x:Name="Body">
        <ItemsControl ItemsSource="{Binding Lessons}" c:Appear.CascadeHost="True">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="s:LessonRowViewModel">
              <s:LessonCardView />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel IsVisible="{Binding IsEmpty}" Spacing="14" Margin="0,48,0,0">
          <c:EmptyState Title="{Binding EmptyTitle}" Hint="{Binding EmptyHint}" Icon="{StaticResource Icon.Calendar}" />
          <StackPanel IsVisible="{Binding IsUnavailable}" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <Button Classes="primary" Content="{loc:T retry}" Command="{Binding RetryCommand}" />
            <Button Classes="pill" Content="{loc:T groupPickTitle}" Command="{Binding ChangeGroupCommand}" />
          </StackPanel>
        </StackPanel>
      </Panel>
    </StackPanel>
  </ScrollViewer>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vograph.Desktop.Controls"
             xmlns:loc="using:Vograph.Desktop.Services"
             xmlns:s="using:Vograph.Desktop.Features.Schedule"
             x:Class="Vograph.Desktop.Features.Schedule.LessonCardView"
             x:DataType="s:LessonRowViewModel">
  <Border Name="Card" Classes="card hoverable" Classes.next="{Binding IsNext}" Classes.past="{Binding IsPast}"
          c:Appear.Kind="Cascade" c:Appear.Index="{Binding Index}" Cursor="Hand">
    <Grid ColumnDefinitions="64,*" RowDefinitions="Auto,Auto,Auto">
      <Button Grid.Column="1" Classes="ghost icon" HorizontalAlignment="Right" VerticalAlignment="Top" ZIndex="1"
              Classes.on="{Binding IsSheetOpen}" Command="{Binding ToggleSheetCommand}"
              ToolTip.Tip="Действия с парой" AutomationProperties.Name="Действия с парой" AutomationProperties.AutomationId="Lesson.More">
        <c:Icon Data="{StaticResource Icon.More}" Size="14" />
      </Button>

      <!-- time column -->
      <StackPanel>
        <TextBlock Classes="tnum" Text="{Binding TimeStart}" FontSize="15" FontWeight="Medium" />
        <TextBlock Classes="tnum muted caption" Text="{Binding TimeEnd}" />
        <TextBlock Classes="faint" FontSize="12" Text="{Binding NextDateText}" Margin="0,4,0,0" IsVisible="{Binding HasNextDate}" />
      </StackPanel>

      <!-- subject, teacher, note, homework -->
      <StackPanel Grid.Column="1" Margin="12,0,44,0">
        <TextBlock Text="Пересечение времени занятий" IsVisible="{Binding HasConflict}" Classes="muted caption" />
        <TextBlock Classes="muted caption" Text="{Binding PriorityCaption}" IsVisible="{Binding IsNext}" />
        <WrapPanel>
          <TextBlock Classes="subject" FontSize="17" FontWeight="Medium" TextWrapping="Wrap" Text="{Binding DisplayName}" VerticalAlignment="Center" AutomationProperties.AutomationId="Lesson.Title" />
          <Border Classes="chip pastmark" Margin="8,0,0,0" VerticalAlignment="Center" IsVisible="{Binding IsPast}" AutomationProperties.AutomationId="Lesson.Past">
            <TextBlock Classes="caption" Text="{loc:T pastLesson}" Foreground="{DynamicResource Brush.Text2}" />
          </Border>
          <Border Classes="chip type lessonbadge" Classes.lecture="{Binding IsLectureType}" Classes.practice="{Binding IsPracticeType}"
                  Classes.lab="{Binding IsLabType}" Classes.consult="{Binding IsConsultType}"
                  Classes.credit="{Binding IsCreditType}" Classes.exam="{Binding IsExamType}"
                  Classes.course="{Binding IsCourseType}" Margin="8,0,0,0"
                  VerticalAlignment="Center" IsVisible="{Binding HasType}">
            <Grid>
              <Border Classes="typewash" />
              <StackPanel Orientation="Horizontal" Spacing="4" Margin="8,3">
                <Ellipse Classes="typedot" Width="6" Height="6" VerticalAlignment="Center" />
                <TextBlock Text="{Binding TypeLabel}" VerticalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>
        </WrapPanel>
          <ItemsControl ItemsSource="{Binding Friends}" Margin="0,5,0,0" IsVisible="{Binding HasFriends}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel ItemSpacing="8" LineSpacing="5" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="s:FriendMarkViewModel">
                <WrapPanel ItemSpacing="5" LineSpacing="3" ToolTip.Tip="{Binding Tooltip}">
                  <c:FriendDot ColorIndex="{Binding ColorIndex}" Fill="{Binding Fill}" Opacity="{Binding Opacity}" VerticalAlignment="Center" />
                  <c:Icon Data="{StaticResource Icon.Calendar}" Size="12" IsVisible="{Binding ShowLessonStatus}" VerticalAlignment="Center" />
                  <TextBlock Classes="muted caption" Text="{Binding GroupName}" IsVisible="{Binding ShowLessonStatus}" />
                  <TextBlock Classes="muted caption" Text="{Binding LessonStatusCaption}" IsVisible="{Binding ShowLessonStatus}" TextWrapping="Wrap" />
                </WrapPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        <TextBlock IsVisible="{Binding ShowDetails}" Classes="muted caption" Text="{Binding TeacherLine}" Margin="0,3,0,0" TextWrapping="Wrap" />
        <Button Classes="ghost" Content="Открыть преподавателя" Command="{Binding OpenTeacherCommand}" IsVisible="{Binding CanOpenTeacher}" HorizontalAlignment="Left" />
        <StackPanel IsVisible="{Binding HasSubgroup}" Margin="0,8,0,0" Spacing="6">
          <TextBlock Classes="muted caption" Text="{Binding SubgroupPrompt}" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding SubgroupOptions}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="s:SubgroupOptionViewModel">
                <Button Classes="pill" Margin="0,0,6,0" Content="{Binding Label}"
                        Command="{Binding SelectCommand}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <TextBlock Classes="muted caption" FontStyle="Italic" Text="{Binding Note}" IsVisible="{Binding HasNote}" Margin="0,2,0,0" TextWrapping="Wrap" />

        <ItemsControl ItemsSource="{Binding Homework}" Margin="0,8,0,0" IsVisible="{Binding ShowHomeworkDetails}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="s:HomeworkItemViewModel">
              <Button Classes="hw" Classes.approaching="{Binding IsApproaching}" Classes.burning="{Binding IsBurning}"
                      Classes.urgent="{Binding IsUrgent}" Classes.overdue="{Binding IsOverdue}" Classes.done="{Binding IsDone}"
                      AutomationProperties.AutomationId="Lesson.Hw" AutomationProperties.Name="{Binding Text}">
                <Button.Flyout>
                  <MenuFlyout Placement="BottomEdgeAlignedLeft">
                    <MenuItem Header="{Binding DoneLabel}" Command="{Binding ToggleDoneCommand}" />
                    <MenuItem Header="{loc:T hwEdit}" Command="{Binding EditCommand}" />
                    <MenuItem Header="{loc:T hwDelete}" Command="{Binding DeleteCommand}" />
                  </MenuFlyout>
                </Button.Flyout>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Ellipse Classes="hwdot" Fill="{Binding $parent[Button].Foreground}" />
                  <TextBlock Classes="hwtext" Text="{Binding Text}" TextTrimming="CharacterEllipsis" MaxWidth="340" />
                  <TextBlock Text="{Binding Label}" Opacity="0.85" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <WrapPanel Grid.Row="1" Grid.Column="1" Margin="12,6,0,0" ItemSpacing="6"><TextBlock Text="{Binding RoomText}" FontWeight="Medium" /><TextBlock Classes="muted caption" Text="{Binding BuildingTag}" IsVisible="{Binding HasBuildingTag}" /></WrapPanel>
      <!-- #9 (G-2): закрытая карточка — максимум одно действие («Карта» у текущей/следующей пары); остальное — в листе пары. -->
      <Button Grid.Row="2" Grid.ColumnSpan="2" Classes="primary" Margin="0,10,0,0" HorizontalAlignment="Left"
              Content="{loc:T openMap}" Command="{Binding ShowMapCommand}" IsEnabled="{Binding CanShowMap}" ToolTip.Tip="{loc:T mapTip}"
              IsVisible="{Binding ShowInlineMap}" AutomationProperties.AutomationId="Lesson.InlineMap" />
      <!-- Лист пары: тот же набор, что в LessonSheet на web (Карта · Домашка · Обсудить в чате группы), плюс действия desktop. -->
      <Border Grid.Row="2" Grid.ColumnSpan="2" Classes="lessonsheet" Margin="0,10,0,0" IsVisible="{Binding IsSheetOpen}"
              AutomationProperties.AutomationId="Lesson.Sheet">
        <WrapPanel ItemSpacing="8" LineSpacing="6">
          <Button Classes="primary" Content="{loc:T openMap}" Command="{Binding ShowMapCommand}" IsEnabled="{Binding CanShowMap}" ToolTip.Tip="{loc:T mapTip}" AutomationProperties.AutomationId="Lesson.Map" />
          <Button Classes="secondary" Content="Домашка" Command="{Binding OpenHomeworksCommand}" AutomationProperties.AutomationId="Lesson.Homework" />
          <Button Classes="ghost" Content="{loc:T discussInGroupChat}" Command="{Binding DiscussCommand}" />
          <Button Classes="ghost" Content="{Binding DetailsCaption}" Command="{Binding ToggleDetailsCommand}" />
          <Button Classes="ghost" Content="Добавить задание" Command="{Binding AddHomeworkCommand}" />
          <Button Classes="ghost" Content="Переименовать" Command="{Binding RenameCommand}" AutomationProperties.AutomationId="Lesson.Rename" />
        </WrapPanel>
      </Border>
    </Grid>
  </Border>
</UserControl>

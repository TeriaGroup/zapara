<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vograph.Desktop.Controls"
             xmlns:loc="using:Vograph.Desktop.Services"
             xmlns:t="using:Vograph.Desktop.Features.Teachers"
             x:Class="Vograph.Desktop.Features.Teachers.TeachersView"
             x:DataType="t:TeachersViewModel">
  <Grid RowDefinitions="Auto,*" Margin="32,26">
    <StackPanel Margin="0,0,0,16">
      <TextBlock Classes="display" Text="{Binding Title}" />
      <TextBlock Classes="muted" Text="{Binding CountText}" Margin="0,4,0,0" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="320,24,*">
      <!-- left: search, filter, list -->
      <Grid RowDefinitions="Auto,Auto,Auto,*">
        <TextBox Text="{Binding Query}" PlaceholderText="{loc:T teachersSearchHint}" />
        <c:Switch Grid.Row="1" Content="{loc:T teachersOnlyMine}" IsChecked="{Binding OnlyMine}" Margin="0,10,0,0" />
        <TextBlock Grid.Row="2" Classes="muted caption" Text="{Binding LoadError}" TextWrapping="Wrap" Margin="0,8,0,0"
                   IsVisible="{Binding LoadError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Grid.Row="2" Classes="muted caption" Text="{loc:T teachersLoading}" Margin="0,8,0,0" IsVisible="{Binding IsLoading}" />
        <ListBox Grid.Row="3" Margin="0,10,0,0" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="t:TeacherItem">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                <TextBlock Classes="muted caption" Text="{Binding Kafedra}" IsVisible="{Binding Kafedra, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <!-- right: detail -->
      <c:EmptyState Grid.Column="2" IsVisible="{Binding !HasDetail}" Title="{loc:T teachersPick}" Hint="{loc:T teachersPickHint}"
                    Icon="{StaticResource Icon.Teachers}" VerticalAlignment="Center" />
      <ScrollViewer Grid.Column="2" IsVisible="{Binding HasDetail}">
        <ContentControl Content="{Binding Detail}">
          <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="t:TeacherDetailViewModel">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Classes="title" Text="{Binding Name}" />
                    <TextBlock Classes="muted caption" Text="{Binding Kafedra}" IsVisible="{Binding HasKafedra}" />
                    <TextBlock Classes="faint caption" Text="{Binding MineLine}" Margin="0,2,0,0" />
                  </StackPanel>
                  <c:SegmentedControl Grid.Column="1" VerticalAlignment="Top" Items="{Binding SegmentItems}" SelectedIndex="{Binding ParityIndex}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Days}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="t:TeacherDay">
                      <Border Classes="card" Classes.next="{Binding IsToday}">
                        <StackPanel Spacing="8">
                          <TextBlock Classes="subject" Text="{Binding Title}" />
                          <TextBlock Classes="faint" Text="{loc:T noLessons}" IsVisible="{Binding Rows.Count, Converter={x:Static t:TeacherConverters.IsZero}}" />
                          <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="t:TeacherRow">
                                <Grid ColumnDefinitions="56,*,Auto">
                                  <StackPanel>
                                    <TextBlock Classes="tnum" Text="{Binding Time}" FontWeight="Medium" />
                                    <TextBlock Classes="tnum muted caption" Text="{Binding TimeEnd}" />
                                  </StackPanel>
                                  <StackPanel Grid.Column="1" Margin="10,0">
                                    <WrapPanel>
                                      <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                      <Border Classes="chip type" Margin="6,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding TypeLabel}" /></Border>
                                      <Border Classes="badge" Margin="6,0,0,0" VerticalAlignment="Center" IsVisible="{Binding IsMine}"><TextBlock Text="{loc:T teachersMine}" /></Border>
                                    </WrapPanel>
                                    <TextBlock Classes="muted caption" Text="{Binding Groups}" TextWrapping="Wrap" />
                                  </StackPanel>
                                  <StackPanel Grid.Column="2" Spacing="4" HorizontalAlignment="Right">
                                    <Border Classes="chip" HorizontalAlignment="Right"><TextBlock Classes="tnum" Text="{Binding Room}" /></Border>
                                    <TextBlock Classes="faint caption" Text="{Binding ParityLabel}" HorizontalAlignment="Right" />
                                  </StackPanel>
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>

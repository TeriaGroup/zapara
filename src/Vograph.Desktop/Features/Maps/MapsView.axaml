<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vograph.Desktop.Controls"
             xmlns:loc="using:Vograph.Desktop.Services"
             xmlns:m="using:Vograph.Desktop.Features.Maps"
             x:Class="Vograph.Desktop.Features.Maps.MapsView"
             x:DataType="m:MapsViewModel">
  <Grid RowDefinitions="Auto,Auto,*" Margin="32,26">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Margin="0,0,16,0">
        <TextBlock Classes="display" Text="{Binding Title}" />
        <TextBlock Classes="muted" Text="{Binding ContextLine}" Margin="0,4,0,0" TextWrapping="Wrap" />
      </StackPanel>
      <Button Grid.Column="1" Classes="pill" VerticalAlignment="Bottom" Command="{Binding GoToNextCommand}" IsVisible="{Binding ShowGoToNext}"
              AutomationProperties.AutomationId="Maps.ToNext" AutomationProperties.Name="{loc:T mapToNext}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <c:Icon Data="{StaticResource Icon.Crosshair}" Size="14" />
          <TextBlock Text="{loc:T mapToNext}" />
        </StackPanel>
      </Button>
    </Grid>

    <WrapPanel Grid.Row="1" ItemSpacing="12" LineSpacing="8" Margin="0,14,0,10">
      <c:SegmentedControl Name="MapsBuilding" Items="{Binding SegmentItems}" SelectedIndex="{Binding BuildingIndex}" VerticalAlignment="Center" />
      <ItemsControl ItemsSource="{Binding Floors}" VerticalAlignment="Center">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="m:FloorPill">
            <Button Classes="pill" Classes.on="{Binding IsSelected}" Content="{Binding Label}"
                    Command="{Binding $parent[ItemsControl].((m:MapsViewModel)DataContext).SelectFloorCommand}" CommandParameter="{Binding}"
                    AutomationProperties.AutomationId="Maps.Floor" AutomationProperties.Name="{Binding Label}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <Button Classes="icon" Click="OnZoomOut" ToolTip.Tip="{loc:T mapZoomOut}"
                AutomationProperties.AutomationId="Maps.ZoomOut" AutomationProperties.Name="{loc:T mapZoomOut}"><c:Icon Data="{StaticResource Icon.Minus}" Size="16" /></Button>
        <Button Classes="icon" Click="OnZoomIn" ToolTip.Tip="{loc:T mapZoomIn}"
                AutomationProperties.AutomationId="Maps.ZoomIn" AutomationProperties.Name="{loc:T mapZoomIn}"><c:Icon Data="{StaticResource Icon.Plus}" Size="16" /></Button>
        <Button Classes="icon" Click="OnFit" ToolTip.Tip="{loc:T mapFit}"
                AutomationProperties.AutomationId="Maps.Fit" AutomationProperties.Name="{loc:T mapFit}"><c:Icon Data="{StaticResource Icon.Fit}" Size="16" /></Button>
        <Button Classes="pill" Click="OnReset" Content="{loc:T mapReset}" AutomationProperties.AutomationId="Maps.Reset" />
        <Button Classes="icon" Command="{Binding ToggleFullscreenCommand}" ToolTip.Tip="{loc:T mapFullscreen}"
                AutomationProperties.AutomationId="Maps.Fullscreen" AutomationProperties.Name="{loc:T mapFullscreen}"><c:Icon Data="{StaticResource Icon.Fullscreen}" Size="16" /></Button>
        <Button Classes="icon" ToolTip.Tip="{loc:T mapMore}"
                AutomationProperties.AutomationId="Maps.More" AutomationProperties.Name="{loc:T mapMore}">
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuItem Header="{loc:T mapDownloadAll}" Command="{Binding DownloadAllCommand}" IsEnabled="{Binding !IsDownloading}" />
              <MenuItem Header="{loc:T mapOpenSite}" Command="{Binding OpenSiteCommand}" />
              <MenuItem Header="{loc:T mapOpenFolder}" Command="{Binding OpenFolderCommand}" />
              <MenuItem Header="{loc:T mapVerify}" Command="{Binding VerifyCommand}" />
              <Separator />
              <MenuItem Header="{Binding CacheStatus}" IsEnabled="False" />
            </MenuFlyout>
          </Button.Flyout>
          <c:Icon Data="{StaticResource Icon.More}" Size="16" />
        </Button>
      </StackPanel>
    </WrapPanel>

    <Border Grid.Row="2" Classes="card" Padding="0" ClipToBounds="True"
            AutomationProperties.AutomationId="Maps.Plan" AutomationProperties.AccessibilityView="Content">
      <Panel>
        <c:ZoomPanel x:Name="Zoom" IsVisible="{Binding HasMap}" AnimateZoom="{Binding Motion.Enabled}">
          <Panel>
            <Image Source="{Binding Image}" Stretch="None" />
            <Canvas IsVisible="{Binding HasHighlight}">
              <!-- glow: the same rectangle 6px wider, pulsing (Motion.axaml) -->
              <Border Classes="mapglow" Canvas.Left="{Binding HighlightLeft}" Canvas.Top="{Binding HighlightTop}" Width="{Binding HighlightWidth}" Height="{Binding HighlightHeight}"
                      Margin="-6" BorderBrush="{DynamicResource Brush.MapInkSoft}" BorderThickness="6" CornerRadius="8" />
              <Border Canvas.Left="{Binding HighlightLeft}" Canvas.Top="{Binding HighlightTop}" Width="{Binding HighlightWidth}" Height="{Binding HighlightHeight}"
                      BorderBrush="{DynamicResource Brush.MapInk}" BorderThickness="2" CornerRadius="4" />
            </Canvas>
          </Panel>
        </c:ZoomPanel>
        <!-- The label lives outside the zoom transform (constant size at any scale); MapsView.axaml.cs positions it. -->
        <Border x:Name="HighlightLabel" Classes="chip" Background="{DynamicResource Brush.MapInk}" HorizontalAlignment="Left" VerticalAlignment="Top"
                IsVisible="{Binding HasHighlight}" IsHitTestVisible="False">
          <TextBlock Text="{Binding HighlightLabel}" Foreground="{DynamicResource Brush.OnMapInk}" FontWeight="SemiBold" />
        </Border>
        <c:EmptyState IsVisible="{Binding !HasMap}" Title="{Binding ContextLine}" Hint="{loc:T mapRemoteHint}" Icon="{StaticResource Icon.Map}" VerticalAlignment="Center" />
        <TextBlock Classes="muted caption" Text="{Binding ImageError}" IsVisible="{Binding ImageError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
        <Border Classes="chip" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" IsVisible="{Binding HasNote}">
          <TextBlock Text="{Binding Note}" />
        </Border>
        <Border Classes="chip" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12">
          <Panel>
            <TextBlock Classes="muted" Text="{Binding CacheStatus}" IsVisible="{Binding !IsDownloading}" />
            <TextBlock Classes="muted" Text="{loc:T mapDownloading}" IsVisible="{Binding IsDownloading}" />
          </Panel>
        </Border>
      </Panel>
    </Border>
  </Grid>
</UserControl>

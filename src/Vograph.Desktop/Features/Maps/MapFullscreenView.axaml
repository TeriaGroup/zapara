<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vograph.Desktop.Controls"
             xmlns:loc="using:Vograph.Desktop.Services"
             xmlns:m="using:Vograph.Desktop.Features.Maps"
             x:Class="Vograph.Desktop.Features.Maps.MapFullscreenView"
             x:DataType="m:MapFullscreenViewModel">
  <Panel Background="{DynamicResource Brush.Canvas}">
    <c:ZoomPanel x:Name="Zoom" IsVisible="{Binding !Owner.ShowStack}" AnimateZoom="{Binding Owner.Motion.Enabled}">
      <Panel>
        <Image Source="{Binding Owner.Image}" Stretch="None" />
        <m:RoutePathLayer x:Name="RoutePath" Strokes="{Binding Owner.PathStrokes}" IsVisible="{Binding Owner.HasPath}" />
        <Canvas IsVisible="{Binding Owner.HasHighlight}">
          <!-- glow: the same rectangle 6px wider, pulsing (Motion.axaml) -->
          <Border Classes="mapglow" Canvas.Left="{Binding Owner.HighlightLeft}" Canvas.Top="{Binding Owner.HighlightTop}" Width="{Binding Owner.HighlightWidth}" Height="{Binding Owner.HighlightHeight}"
                  Margin="-6" BorderBrush="{DynamicResource Brush.MapInkSoft}" BorderThickness="6" CornerRadius="8" />
          <Border Canvas.Left="{Binding Owner.HighlightLeft}" Canvas.Top="{Binding Owner.HighlightTop}" Width="{Binding Owner.HighlightWidth}" Height="{Binding Owner.HighlightHeight}"
                  BorderBrush="{DynamicResource Brush.MapInk}" BorderThickness="2" CornerRadius="4" />
        </Canvas>
      </Panel>
    </c:ZoomPanel>
    <m:StairMarkersOverlay x:Name="StairMarkers" Markers="{Binding Owner.StairMarkers}" IsVisible="{Binding !Owner.ShowStack}"
                           AutomationProperties.AutomationId="MapsFull.StairMarkers" AutomationProperties.Name="Лестницы маршрута" />
    <m:CampusStackView IsVisible="{Binding Owner.ShowStack}" Route="{Binding Owner.Route}" Building="{Binding Owner.ShownBuilding}"
                       FloorImages="{Binding Owner.StackFloorImages}" AllowOrbit="{Binding Owner.Motion.Enabled}"
                       AutomationProperties.AutomationId="MapsFull.StackView" />
    <!-- The label lives outside the zoom transform (constant size at any scale); MapFullscreenView.axaml.cs positions it. -->
    <Border x:Name="HighlightLabel" Classes="chip" Background="{DynamicResource Brush.MapInk}" HorizontalAlignment="Left" VerticalAlignment="Top"
            IsVisible="{Binding Owner.ShowHighlightChrome}" IsHitTestVisible="False">
      <TextBlock Text="{Binding Owner.HighlightLabel}" Foreground="{DynamicResource Brush.OnMapInk}" FontWeight="SemiBold" />
    </Border>
    <Border Classes="card" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16" Padding="12,8">
      <StackPanel>
        <TextBlock Text="{Binding Owner.ContextLine}" />
        <TextBlock Classes="muted" Text="{Binding Owner.RouteUnmarked}" IsVisible="{Binding Owner.IsRouteUnmarked}" Margin="0,4,0,0" />
      </StackPanel>
    </Border>
    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16">
      <Button Classes="icon" Click="OnZoomOut" ToolTip.Tip="{loc:T mapZoomOut}"
              AutomationProperties.AutomationId="MapsFull.ZoomOut" AutomationProperties.Name="{loc:T mapZoomOut}"><c:Icon Data="{StaticResource Icon.Minus}" Size="16" /></Button>
      <Button Classes="icon" Click="OnZoomIn" ToolTip.Tip="{loc:T mapZoomIn}"
              AutomationProperties.AutomationId="MapsFull.ZoomIn" AutomationProperties.Name="{loc:T mapZoomIn}"><c:Icon Data="{StaticResource Icon.Plus}" Size="16" /></Button>
      <Button Classes="icon" Click="OnFit" ToolTip.Tip="{loc:T mapFit}"
              AutomationProperties.AutomationId="MapsFull.Fit" AutomationProperties.Name="{loc:T mapFit}"><c:Icon Data="{StaticResource Icon.Fit}" Size="16" /></Button>
      <Button Classes="icon" Command="{Binding CloseCommand}" ToolTip.Tip="{loc:T mapExitFullscreen}"
              AutomationProperties.AutomationId="MapsFull.Close" AutomationProperties.Name="{loc:T mapExitFullscreen}"><c:Icon Data="{StaticResource Icon.X}" Size="16" /></Button>
    </StackPanel>
  </Panel>
</UserControl>

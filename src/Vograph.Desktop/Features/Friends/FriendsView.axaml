<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vograph.Desktop.Controls"
             xmlns:loc="using:Vograph.Desktop.Services"
             xmlns:f="using:Vograph.Desktop.Features.Friends"
             x:Class="Vograph.Desktop.Features.Friends.FriendsView"
             x:DataType="f:FriendsViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="32,26" Spacing="14" MaxWidth="880" HorizontalAlignment="Left">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Margin="0,0,16,0">
          <TextBlock Classes="display" Text="{Binding Title}" />
          <TextBlock Classes="muted" Text="{Binding Subtitle}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
          <TextBlock Classes="muted caption" Text="{Binding CountText}" VerticalAlignment="Center" />
          <TextBlock Classes="faint caption" Text="{loc:T friendsMax}" VerticalAlignment="Center" IsVisible="{Binding !CanAdd}" />
          <Button Classes="primary" Command="{Binding AddCommand}" IsEnabled="{Binding CanAdd}"
                  AutomationProperties.AutomationId="Friends.Add" AutomationProperties.Name="{loc:T friendsAdd}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:Icon Data="{StaticResource Icon.Plus}" Size="14" />
              <TextBlock Text="{loc:T friendsAdd}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <Border Height="1" Background="{DynamicResource Brush.Line}" Margin="0,0,0,2" />
      <Border Classes="card" AutomationProperties.AutomationId="Friends.Forecast">
        <StackPanel Spacing="10">
          <TextBlock Classes="micro" Text="БЛИЖАЙШИЕ ПЕРЕСЕЧЕНИЯ" />
          <TextBlock Classes="muted caption" Text="До трёх встреч на ближайшие 14 дней" />
          <Button Classes="pill" Content="Обновить расписания" Command="{Binding RefreshSchedulesCommand}"
                  HorizontalAlignment="Left" AutomationProperties.AutomationId="Friends.RefreshSchedules" />
          <TextBlock Classes="muted" Text="{Binding ForecastStatus}" TextWrapping="Wrap"
                     IsVisible="{Binding ForecastStatus, Converter={x:Static f:FriendConverters.IsNonEmpty}}" />
          <ItemsControl ItemsSource="{Binding Encounters}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="f:FriendEncounterViewModel">
                <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1" Padding="0,4,0,10">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <c:FriendDot ColorIndex="{Binding ColorIndex}" Fill="Full" Width="14" Height="14" VerticalAlignment="Top" Margin="0,4,0,0" />
                    <StackPanel Spacing="3">
                      <TextBlock Classes="subject" Text="{Binding When}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding GroupDisplay}" TextWrapping="Wrap" />
                      <TextBlock Classes="muted caption" Text="{Binding Place}" TextWrapping="Wrap" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="muted caption" Text="{Binding MissingSchedulesText}" TextWrapping="Wrap"
                     IsVisible="{Binding MissingSchedulesText, Converter={x:Static f:FriendConverters.IsNonEmpty}}" />
        </StackPanel>
      </Border>
      <c:EmptyState IsVisible="{Binding Friends.Count, Converter={x:Static f:FriendConverters.IsZero}}" Title="{loc:T friendsEmpty}" Hint="{loc:T friendsEmptyHint}" Icon="{StaticResource Icon.Friends}" Margin="0,24" />

      <ItemsControl ItemsSource="{Binding Friends}" c:Appear.CascadeHost="True">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="f:FriendItemViewModel">
            <Border Classes="card" c:Appear.Kind="Cascade" c:Appear.Index="{Binding Index}">
              <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" VerticalAlignment="Center">
                <!-- colour: a dot that opens the palette (taken colours are hidden) -->
                <Button Classes="icon" ToolTip.Tip="{loc:T friendsColor}"
                        AutomationProperties.AutomationId="Friend.Color" AutomationProperties.Name="{loc:T friendsColor}">
                  <Button.Flyout>
                    <Flyout Placement="Bottom">
                      <ItemsControl ItemsSource="{Binding ColorOptions}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="f:ColorOption">
                            <Button Classes="icon" Command="{Binding $parent[ItemsControl].((f:FriendItemViewModel)DataContext).PickColorCommand}" CommandParameter="{Binding}">
                              <Ellipse Width="14" Height="14" Fill="{Binding Index, Converter={x:Static loc:Converters.FriendBrush}}"
                                       Stroke="{DynamicResource Brush.Text1}" StrokeThickness="{Binding IsCurrent, Converter={x:Static f:FriendConverters.CurrentStroke}}" />
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Flyout>
                  </Button.Flyout>
                  <c:FriendDot ColorIndex="{Binding ColorIndex}" Fill="Full" Width="14" Height="14" />
                </Button>
                <TextBlock Grid.Column="1" Classes="subject" Text="{Binding GroupName}" VerticalAlignment="Center" Margin="10,0" TextTrimming="CharacterEllipsis" MaxWidth="160" />
                <TextBox Grid.Column="2" MinWidth="0" Text="{Binding MemberNames}" PlaceholderText="{loc:T friendsNames}" LostFocus="OnNamesLostFocus" KeyDown="OnNamesKeyDown" Margin="0,0,12,0"
                         AutomationProperties.AutomationId="Friend.Names" />
                <c:Switch Grid.Column="3" Content="{loc:T friendsEnabled}" IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,12,0"
                          AutomationProperties.AutomationId="Friend.Enabled" />
                <Button Grid.Column="4" Classes="danger" Content="{loc:T friendsRemove}" Command="{Binding RemoveCommand}"
                        AutomationProperties.AutomationId="Friend.Remove" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Classes="card" Margin="0,10,0,0">
        <StackPanel Spacing="12">
          <TextBlock Classes="micro" Text="{loc:TU intersections}" />
          <TextBlock Classes="muted caption" Text="Совпадение рассчитано по времени и аудиториям в расписании, а не по фактическому местоположению." TextWrapping="Wrap" />
          <c:SegmentedControl Items="{Binding TickLabels}" SelectedIndex="{Binding StrictnessIndex}"
                              AutomationProperties.AutomationId="Friends.Strictness" />
          <c:Switch Content="{loc:T alwaysShowAll}" IsChecked="{Binding AlwaysShowAll}" AutomationProperties.AutomationId="Friends.AlwaysAll" />
          <TextBlock Classes="faint caption" Text="{loc:T alwaysShowAllHint}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Vograph.Desktop.Controls"
             xmlns:loc="using:Vograph.Desktop.Services"
             xmlns:vm="using:Vograph.Desktop.Features.States"
             x:Class="Vograph.Desktop.Features.States.PlaceholderView"
             x:DataType="vm:PlaceholderViewModel">
  <StackPanel Margin="32,26" MaxWidth="760" Spacing="40">
    <TextBlock Classes="display" Text="{Binding Title}" />
    <c:EmptyState Title="{loc:T placeholderTitle}" Hint="{loc:T placeholderHint}" Icon="{StaticResource Icon.Week}" />
  </StackPanel>
</UserControl>

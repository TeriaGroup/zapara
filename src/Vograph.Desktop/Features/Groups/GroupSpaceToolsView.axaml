<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:g="using:Vograph.Desktop.Features.Groups" xmlns:contracts="using:Zapara.Contracts.Communities" x:Class="Vograph.Desktop.Features.Groups.GroupSpaceToolsView" x:DataType="g:GroupViewModel">
 <StackPanel Spacing="8">
  <TextBlock Classes="muted caption" Text="{Binding CapabilitySummary}" TextWrapping="Wrap" />
  <Button Content="Структура и права группы" Command="{Binding ToggleSpaceToolsCommand}" />
  <StackPanel Spacing="8" IsVisible="{Binding PreviewMode}"><TextBlock Text="Просмотр от лица участника. Все изменения отключены." TextWrapping="Wrap" /><Button Content="Вернуться к своим правам" Command="{Binding EndPreviewCommand}" /></StackPanel>
  <StackPanel Spacing="10" IsVisible="{Binding ShowSpaceTools}">
   <StackPanel Spacing="6" IsVisible="{Binding CanManageChannels}">
    <TextBlock Classes="subject" Text="Категории" />
    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"><ComboBox.ItemTemplate><DataTemplate x:DataType="contracts:GroupCategoryResponse"><TextBlock Text="{Binding Title}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
    <TextBox Text="{Binding CategoryTitle}" PlaceholderText="Название категории" /><NumericUpDown Value="{Binding CategoryPosition}" Minimum="0" Maximum="100" AutomationProperties.Name="Порядок категории" />
    <WrapPanel ItemSpacing="6"><Button Content="Новая" Command="{Binding NewCategoryCommand}" /><Button Content="Сохранить" Command="{Binding SaveCategoryCommand}" /><Button Content="Удалить категорию" Command="{Binding DeleteCategoryCommand}" /></WrapPanel>
    <TextBlock Classes="muted caption" Text="Удаление категории переносит её темы в корень." TextWrapping="Wrap" />

   </StackPanel>
    <Button Content="Открыть архив" Command="{Binding LoadArchiveCommand}" />
    <ItemsControl ItemsSource="{Binding ArchivedChannels}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="g:GroupChannelRow"><Button Content="{Binding Title}" Command="{Binding OpenCommand}" ToolTip.Tip="Открыть архивную тему" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <StackPanel Spacing="6" IsVisible="{Binding CanManageRoles}">
    <TextBlock Classes="subject" Text="Роли приложения" />
    <TextBlock Classes="muted caption" Text="Старосту и куратора назначает администрация приложения. Дополнительные роли не меняют эти статусы." TextWrapping="Wrap" />
    <TextBox Text="{Binding TrustedRoleName}" PlaceholderText="Новая роль" /><Button Content="Создать роль" Command="{Binding CreateTrustedRoleCommand}" IsEnabled="{Binding CanCreateRole}" />
    <ComboBox ItemsSource="{Binding TrustedRoles}" SelectedItem="{Binding SelectedTrustedRole}"><ComboBox.ItemTemplate><DataTemplate x:DataType="g:GroupTrustedRoleRow"><TextBlock Text="{Binding Display}" TextWrapping="Wrap" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
    <TextBox Text="{Binding RoleEditName}" PlaceholderText="Название роли" /><TextBox Text="{Binding RoleEditIcon}" PlaceholderText="Значок роли" />
    <NumericUpDown Value="{Binding RoleEditPosition}" Minimum="0" Maximum="100" AutomationProperties.Name="Уровень роли" />
    <Button Content="Сохранить роль" Command="{Binding SaveRoleSettingsCommand}" IsEnabled="{Binding CanSaveRoleSettings}" />
    <StackPanel Spacing="6" IsVisible="{Binding RoleEditConflict}"><TextBlock Text="Роль изменена на другом устройстве. Ваши правки сохранены в редакторе. Загрузите актуальную роль перед сохранением." TextWrapping="Wrap" Classes="muted caption" /><Button Content="Загрузить актуальную роль" Command="{Binding ReloadRoleSettingsCommand}" /></StackPanel>
    <ItemsControl ItemsSource="{Binding RolePowers}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="g:SpacePowerRow"><Button Content="{Binding Label}" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch" Command="{Binding $parent[UserControl].((g:GroupViewModel)DataContext).ToggleRolePowerCommand}" CommandParameter="{Binding}" IsEnabled="{Binding $parent[UserControl].((g:GroupViewModel)DataContext).CanEditSelectedRole}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <Button Content="Проверить последствия удаления" Command="{Binding InspectRoleImpactCommand}" IsEnabled="{Binding CanEditSelectedRole}" />
    <TextBlock Text="{Binding RoleImpact}" TextWrapping="Wrap" /><Button Content="Удалить роль" Command="{Binding RemoveRoleCommand}" IsVisible="{Binding ConfirmRemoveRole}" />
   </StackPanel>
   <StackPanel Spacing="6" IsVisible="{Binding CanManageGrants}">
    <TextBlock Classes="subject" Text="Назначения" /><TextBlock Classes="muted caption" Text="До трёх дополнительных ролей у участника. Их права объединяются; запреты и ограничения темы проверяет сервер." TextWrapping="Wrap" />
    <ComboBox ItemsSource="{Binding TrustedRoles}" SelectedItem="{Binding SelectedTrustedRole}"><ComboBox.ItemTemplate><DataTemplate x:DataType="g:GroupTrustedRoleRow"><TextBlock Text="{Binding Display}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
    <ComboBox ItemsSource="{Binding TrustCandidates}" SelectedItem="{Binding SelectedTrustCandidate}"><ComboBox.ItemTemplate><DataTemplate x:DataType="g:GroupTrustedPersonRow"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
    <Button Content="Назначить выбранную роль" Command="{Binding GrantTrustedCommand}" IsEnabled="{Binding CanGrantTrusted}" />
    <ItemsControl ItemsSource="{Binding TrustedGrants}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="g:GroupTrustedGrantRow"><StackPanel><TextBlock Text="{Binding Name}" TextWrapping="Wrap" /><Button Content="Снять роль" Command="{Binding RevokeCommand}" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </StackPanel>
   <StackPanel Spacing="6" IsVisible="{Binding CanManageAccess}">
    <TextBlock Classes="subject" Text="Доступ к выбранной теме" /><Button Content="Загрузить правила доступа" Command="{Binding LoadAccessCommand}" />
    <TextBlock Text="Просмотр" /><ComboBox ItemsSource="{Binding SimpleReadChoices}" SelectedItem="{Binding SimpleReadPreset}" />
    <TextBlock Text="Публикация" /><ComboBox ItemsSource="{Binding SimplePostChoices}" SelectedItem="{Binding SimplePostPreset}" />
    <ItemsControl ItemsSource="{Binding SimpleAccessRoles}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="g:SimpleAccessRole"><StackPanel><TextBlock Text="{Binding Name}" TextWrapping="Wrap" /><CheckBox Content="Разрешить читать" IsChecked="{Binding Read}" /><CheckBox Content="Разрешить публиковать" IsChecked="{Binding Post}" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <Button Content="Применить простой выбор к черновику" Command="{Binding ApplySimpleAccessCommand}" />
    <TextBlock Text="Настроено отдельно сохраняет расширенные правила. Остальные права не меняются; итог покажет серверная проверка." TextWrapping="Wrap" Classes="muted caption" />
    <Expander Header="Расширенные правила">    <ItemsControl ItemsSource="{Binding AccessRules}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="g:SpaceAccessRow"><StackPanel Spacing="4" Margin="0,4"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" /><ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding State}" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
    <Button Content="Проверить последствия изменений" Command="{Binding PreviewProposedAccessCommand}" />
    <TextBlock Text="{Binding AccessPreviewSummary}" TextWrapping="Wrap" FontWeight="Medium" />
    <ItemsControl ItemsSource="{Binding AccessPreviewPeople}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="g:SpaceAccessPreviewPerson"><Expander Header="{Binding Name}" Margin="0,4"><StackPanel Spacing="6"><TextBlock Text="{Binding Before}" TextWrapping="Wrap" /><TextBlock Text="↓" /><TextBlock Text="{Binding After}" TextWrapping="Wrap" /><ItemsControl ItemsSource="{Binding Reasons}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="g:SpaceAccessReason"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" Classes="muted caption" Margin="0,3" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Expander></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <Button Classes="primary" Content="Подтвердить и сохранить доступ" Command="{Binding SaveAccessCommand}" IsEnabled="{Binding CanSaveProposedAccess}" />

   </StackPanel>   <StackPanel Spacing="6" IsVisible="{Binding CanManageGroupAccess}"><TextBlock Classes="subject" Text="Просмотр группы от лица роли" /><ComboBox ItemsSource="{Binding TrustedRoles}" SelectedItem="{Binding SelectedTrustedRole}"><ComboBox.ItemTemplate><DataTemplate x:DataType="g:GroupTrustedRoleRow"><TextBlock Text="{Binding Display}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
    <ComboBox IsVisible="{Binding CanManageGroupAccess}" ItemsSource="{Binding TrustCandidates}" SelectedItem="{Binding SelectedTrustCandidate}"><ComboBox.ItemTemplate><DataTemplate x:DataType="g:GroupTrustedPersonRow"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
    <Button Content="Посмотреть от лица участника" Command="{Binding PreviewPersonCommand}" IsVisible="{Binding CanManageGroupAccess}" /><Button Content="Посмотреть от лица выбранной роли" Command="{Binding PreviewRoleCommand}" IsVisible="{Binding CanManageGroupAccess}" />
    <Button Content="Журнал изменений" Command="{Binding LoadAuditCommand}" IsVisible="{Binding CanManageGroupAudit}" /><ItemsControl ItemsSource="{Binding AuditEvents}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,4" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>

  </StackPanel>
 </StackPanel>
</UserControl>

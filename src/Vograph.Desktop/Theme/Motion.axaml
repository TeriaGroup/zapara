<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Vograph.Desktop.Controls">
  <!-- The transitions and looping animations of the design system that a style sheet can take back again (spec §7).
       App includes this file only while MotionSettings.Enabled; without it the same controls snap into place. Nothing
       here changes layout or behaviour. One curve everywhere: cubic-bezier(.2,.8,.2,1).
       No selector here may reach inside a template («/template/», pinned by MotionTests): Avalonia's detach does not
       reach template children, so such a setter is never withdrawn when this file is removed and the animation
       outlives «Анимации». A control owns its own parts' motion instead — Switch, SegmentedControl, Skeleton. -->

  <Styles.Resources>
    <!-- How App.SetMotion recognises this file among Application.Styles: Avalonia's XAML compiler inlines a
         same-assembly StyleInclude into a plain Styles object, so App.axaml's include leaves no Source to match on. -->
    <x:String x:Key="Motion.Styles">on</x:String>
  </Styles.Resources>

  <Style Selector="Button">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" Easing="0.2,0.8,0.2,1" />
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="0.2,0.8,0.2,1" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" Easing="0.2,0.8,0.2,1" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="c|NavItem">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" Easing="0.2,0.8,0.2,1" />
        <BrushTransition Property="Foreground" Duration="0:0:0.15" Easing="0.2,0.8,0.2,1" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" Easing="0.2,0.8,0.2,1" />
      </Transitions>
    </Setter>
  </Style>

  <!-- The sidebar's single indicator slides between items (220 ms) and stretches to their height. -->
  <Style Selector="Border#NavIndicator">
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="0.2,0.8,0.2,1" />
        <DoubleTransition Property="Height" Duration="0:0:0.22" Easing="0.2,0.8,0.2,1" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Border.sidebar">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Width" Duration="0:0:0.2" Easing="0.2,0.8,0.2,1" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" Easing="0.2,0.8,0.2,1" />
        <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.15" Easing="0.2,0.8,0.2,1" />
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="0.2,0.8,0.2,1" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="StackPanel.acts">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="0.2,0.8,0.2,1" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="TextBox">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" Easing="0.2,0.8,0.2,1" />
      </Transitions>
    </Setter>
  </Style>

  <!-- Spec §7: a burning homework dot breathes (1.6 s, alternate) and the map highlight glow pulses. Both sit on an
       element of a view rather than inside a template, so removing this file really does stop them. The segmented
       thumb, the switch track and knob, and the skeleton shine are animated by their controls. -->
  <Style Selector="Button.hw.burning Ellipse.hwdot, Button.hw.urgent Ellipse.hwdot">
    <Style.Animations>
      <Animation Duration="0:0:1.6" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="SineEaseInOut">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.35" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Border.mapglow">
    <Style.Animations>
      <Animation Duration="0:0:1.6" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="SineEaseInOut">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.3" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
</Styles>

<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Inter everywhere; inherited by every control inside the window. -->
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="fonts:Inter#Inter" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text1}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Canvas}" />
  </Style>

  <Style Selector="ComboBox, CheckBox, NumericUpDown, CalendarDatePicker"><Setter Property="MinHeight" Value="48" /><Setter Property="FontSize" Value="15" /></Style>
  <Style Selector="ComboBox, NumericUpDown"><Setter Property="BorderBrush" Value="{DynamicResource Brush.ControlBorder}" /></Style>

  <!-- Text scale. Foreground is NOT set on plain TextBlock so it keeps inheriting (buttons, chips). -->
  <Style Selector="TextBlock.display">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LetterSpacing" Value="0" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TextBlock.subject">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.micro">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="LetterSpacing" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text3}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
  </Style>
  <Style Selector="TextBlock.faint">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text3}" />
  </Style>
  <Style Selector="TextBlock.bad">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Bad}" />
  </Style>
  <Style Selector="TextBlock.tnum">
    <Setter Property="FontFeatures" Value="tnum" />
  </Style>

  <!-- Card: flat surface with a 1px line; hover lifts it. -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Zp.Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Zp.BorderSubtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Card}" />
    <Setter Property="Padding" Value="16,14" />
    <Setter Property="BoxShadow" Value="{DynamicResource Shadow.None}" />
  </Style>
  <Style Selector="Border.card.hoverable:pointerover">
    <Setter Property="Background" Value="{DynamicResource Brush.CardHover}" />
    <Setter Property="BoxShadow" Value="{DynamicResource Shadow.None}" />
  </Style>
  <Style Selector="Border.card.next">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.LineStrong}" />
  </Style>
  <!-- #20: прошедшая пара приглушается фоном и меткой «Прошла», текст остаётся контрастным (≥4.5:1). -->
  <Style Selector="Border.card.past">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
  </Style>
  <Style Selector="Border.card.past Button.primary">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text1}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.ControlBorder}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.card.past Button.primary:pointerover">
    <Setter Property="Background" Value="{DynamicResource Brush.CardHover}" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <!-- Scoped to .hwrow (the Homework section's own row card) on purpose: Border.card.past is shared with
       LessonCardView's lesson card, whose .past means "this lesson's time slot already ended today" —
       unrelated to whether an attached homework is done, so an unscoped rule here would strike through a
       NOT-done homework's text on any lesson card whose lesson already ended today. -->
  <Style Selector="Border.card.hwrow.past TextBlock.hwtext">
    <Setter Property="TextDecorations" Value="Strikethrough" />
  </Style>

  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{DynamicResource Zp.SurfaceChip}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
    <Setter Property="Padding" Value="8,3" />
  </Style>
  <Style Selector="Border.chip TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource Zp.Font.Secondary}" />
  </Style>
  <Style Selector="Border.chip.type.lessonbadge">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.chip.type TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
  </Style>
  <Style Selector="Border.chip.type.lessonbadge TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource Zp.Font.Secondary}" />
    <Setter Property="Foreground" Value="{DynamicResource Zp.TextPrimary}" />
  </Style>
  <Style Selector="Border.chip.type.lessonbadge Border.typewash">
    <Setter Property="Background" Value="{DynamicResource Zp.SurfaceChip}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill}" />
  </Style>
  <Style Selector="Border.chip.type.lessonbadge Ellipse.typedot"><Setter Property="Fill" Value="{DynamicResource Zp.TextSecondary}" /></Style>

  <Style Selector="Border.chip.type.lessonbadge.lecture Border.typewash"><Setter Property="Background" Value="{DynamicResource Zp.Lesson.Lecture}" /><Setter Property="Opacity" Value="0.18" /></Style>
  <Style Selector="Border.chip.type.lessonbadge.lecture Ellipse.typedot"><Setter Property="Fill" Value="{DynamicResource Zp.Lesson.Lecture}" /></Style>
  <Style Selector="Border.chip.type.lessonbadge.practice Border.typewash"><Setter Property="Background" Value="{DynamicResource Zp.Lesson.Practice}" /><Setter Property="Opacity" Value="0.18" /></Style>
  <Style Selector="Border.chip.type.lessonbadge.practice Ellipse.typedot"><Setter Property="Fill" Value="{DynamicResource Zp.Lesson.Practice}" /></Style>
  <Style Selector="Border.chip.type.lessonbadge.lab Border.typewash"><Setter Property="Background" Value="{DynamicResource Zp.Lesson.Lab}" /><Setter Property="Opacity" Value="0.18" /></Style>
  <Style Selector="Border.chip.type.lessonbadge.lab Ellipse.typedot"><Setter Property="Fill" Value="{DynamicResource Zp.Lesson.Lab}" /></Style>
  <Style Selector="Border.chip.type.lessonbadge.consult Border.typewash"><Setter Property="Background" Value="{DynamicResource Zp.Lesson.Consult}" /><Setter Property="Opacity" Value="0.18" /></Style>
  <Style Selector="Border.chip.type.lessonbadge.consult Ellipse.typedot"><Setter Property="Fill" Value="{DynamicResource Zp.Lesson.Consult}" /></Style>
  <Style Selector="Border.chip.type.lessonbadge.credit Border.typewash"><Setter Property="Background" Value="{DynamicResource Zp.Lesson.Credit}" /><Setter Property="Opacity" Value="0.18" /></Style>
  <Style Selector="Border.chip.type.lessonbadge.credit Ellipse.typedot"><Setter Property="Fill" Value="{DynamicResource Zp.Lesson.Credit}" /></Style>
  <Style Selector="Border.chip.type.lessonbadge.exam Border.typewash"><Setter Property="Background" Value="{DynamicResource Zp.Lesson.Exam}" /><Setter Property="Opacity" Value="0.18" /></Style>
  <Style Selector="Border.chip.type.lessonbadge.exam Ellipse.typedot"><Setter Property="Fill" Value="{DynamicResource Zp.Lesson.Exam}" /></Style>
  <Style Selector="Border.chip.type.lessonbadge.course Border.typewash"><Setter Property="Background" Value="{DynamicResource Zp.Lesson.Course}" /><Setter Property="Opacity" Value="0.18" /></Style>
  <Style Selector="Border.chip.type.lessonbadge.course Ellipse.typedot"><Setter Property="Fill" Value="{DynamicResource Zp.Lesson.Course}" /></Style>
  <Style Selector="Border.chip.room">
    <Setter Property="Padding" Value="10,5" />
  </Style>
  <Style Selector="Border.chip.room TextBlock">
    <Setter Property="FontSize" Value="12.5" />
  </Style>

  <!-- Homework status chip in the Homework section: same palette as the Button.hw block on a lesson card
       for approaching/burning/urgent/overdue/done. "far" needs its own rule here (spec 5.7: Brush.Text2)
       because Border.chip's base sets no Foreground of its own, unlike Button.hw's base which already
       defaults to Brush.Text2 — so a lesson card needs no separate .far class. -->
  <Style Selector="Border.chip.approaching TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text1}" />
  </Style>
  <Style Selector="Border.chip.far TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
  </Style>
  <Style Selector="Border.chip.burning">
    <Setter Property="Background" Value="{DynamicResource Brush.WarnSoft}" />
  </Style>
  <Style Selector="Border.chip.burning TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Warn}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.chip.urgent">
    <Setter Property="Background" Value="{DynamicResource Brush.Warn}" />
  </Style>
  <Style Selector="Border.chip.urgent TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Brush.OnWarn}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Border.chip.overdue">
    <Setter Property="Background" Value="{DynamicResource Brush.BadSoft}" />
  </Style>
  <Style Selector="Border.chip.overdue TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Bad}" />
  </Style>
  <Style Selector="Border.chip.done TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
  </Style>

  <Style Selector="Border.chip.stale TextBlock">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
  </Style>
  <Style Selector="Border.chip.stale.warn">
    <Setter Property="Background" Value="{DynamicResource Brush.WarnSoft}" />
  </Style>
  <Style Selector="Border.chip.stale.warn TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Warn}" />
  </Style>

  <Style Selector="Border.badge">
    <Setter Property="Background" Value="{DynamicResource Brush.WarnSoft}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill}" />
    <Setter Property="Padding" Value="7,1" />
  </Style>
  <Style Selector="Border.badge TextBlock">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Warn}" />
  </Style>

  <!-- The homework dot on a lesson card; Motion.axaml makes it breathe once the deadline burns. -->
  <Style Selector="Ellipse.hwdot">
    <Setter Property="Width" Value="6" />
    <Setter Property="Height" Value="6" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Soft outer glow around a plan highlight; Motion.axaml pulses its opacity. -->
  <Style Selector="Border.mapglow">
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <!-- Homework block (a Button so the flyout opens on click). Status classes are set from the view model. -->
  <Style Selector="Button.hw">
    <Setter Property="Background" Value="{DynamicResource Brush.Chip}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
    <Setter Property="Padding" Value="9,5" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.hw.approaching">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text1}" />
  </Style>
  <Style Selector="Button.hw.burning">
    <Setter Property="Background" Value="{DynamicResource Brush.WarnSoft}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Warn}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.hw.urgent">
    <Setter Property="Background" Value="{DynamicResource Brush.Warn}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.OnWarn}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Button.hw.overdue">
    <Setter Property="Background" Value="{DynamicResource Brush.BadSoft}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Bad}" />
  </Style>
  <Style Selector="Button.hw.done">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text2}" />
  </Style>
  <Style Selector="Button.hw.done TextBlock.hwtext">
    <Setter Property="TextDecorations" Value="Strikethrough" />
  </Style>

  <!-- Hover-only row actions: hidden, not just transparent, so Tab never lands on an invisible button. -->
  <Style Selector="StackPanel.acts">
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="Border.card:pointerover StackPanel.acts, Border.card:focus-within StackPanel.acts">
    <Setter Property="IsVisible" Value="True" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Ellipse.staledot">
    <Setter Property="Width" Value="6" />
    <Setter Property="Height" Value="6" />
    <Setter Property="Fill" Value="{DynamicResource Brush.Text3}" />
  </Style>
  <Style Selector="Ellipse.staledot.warn">
    <Setter Property="Fill" Value="{DynamicResource Brush.Warn}" />
  </Style>

  <!-- Toasts -->
  <Style Selector="Border.toast">
    <Setter Property="Background" Value="{DynamicResource Brush.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Toast}" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="BoxShadow" Value="{DynamicResource Shadow.Card}" />
    <Setter Property="MaxWidth" Value="380" />
  </Style>
  <Style Selector="Ellipse.toastdot">
    <Setter Property="Width" Value="7" />
    <Setter Property="Height" Value="7" />
    <Setter Property="Fill" Value="{DynamicResource Brush.Info}" />
  </Style>
  <Style Selector="Ellipse.toastdot.ok"><Setter Property="Fill" Value="{DynamicResource Brush.Ok}" /></Style>
  <Style Selector="Ellipse.toastdot.warn"><Setter Property="Fill" Value="{DynamicResource Brush.Warn}" /></Style>
  <Style Selector="Ellipse.toastdot.bad"><Setter Property="Fill" Value="{DynamicResource Brush.Bad}" /></Style>

  <!-- Fluent's Slider paints the value fill with Foreground and the track with Background. -->
  <Style Selector="Slider">
    <Setter Property="Background" Value="{DynamicResource Brush.Line}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="MinHeight" Value="28" />
  </Style>

  <!-- #20: видимая граница полей ввода (≥3:1 к фону в обеих темах). Стилем, а не в ControlTheme,
       чтобы не пересекаться с #11; цвета совпадают с токеном border-control. -->
  <Style Selector="TextBox"><Setter Property="BorderBrush" Value="{DynamicResource Brush.ControlBorder}" /></Style>
  <Style Selector="TextBox:focus"><Setter Property="BorderBrush" Value="{DynamicResource Brush.Text1}" /></Style>
</Styles>

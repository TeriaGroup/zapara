<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Vograph</AssemblyName>
    <RootNamespace>Vograph.Desktop</RootNamespace>
    <Version>2.0.0</Version>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vograph.Core\Vograph.Core.csproj" />
  </ItemGroup>

  <!-- ShellViewModel is sealed, so its event raisers are internal rather than protected (CS0628);
       the tests drive them directly to check that a detached section stops listening. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Vograph.Desktop.Tests" />
  </ItemGroup>

  <!-- Offline bundle Core reads next to the exe (maps\*.jpg, maps\coords.json, TimetableLecturer50.xml); the updater zip ships the same layout. -->
  <ItemGroup>
    <None Include="Assets\maps\*.jpg" Link="maps\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\maps\coords.json" Link="maps\coords.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\TimetableLecturer50.xml" Link="TimetableLecturer50.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

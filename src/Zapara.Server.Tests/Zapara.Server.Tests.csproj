<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- ImageSharp 3.2.0 checks a Six Labors license at build time (Release fails without one, Debug only warns).
         The free community key is scoped to Zapara.Server.Social and Zapara.Server.Tests and is not committed:
         pass it through the SIXLABORS_LICENSE_KEY environment variable or keep sixlabors.lic next to the project. -->
    <SixLaborsLicenseKey Condition="'$(SixLaborsLicenseKey)' == ''">$(SIXLABORS_LICENSE_KEY)</SixLaborsLicenseKey>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Zapara.Contracts\Zapara.Contracts.csproj" />
    <ProjectReference Include="..\Zapara.Server.Sync\Zapara.Server.Sync.csproj" />
    <ProjectReference Include="..\Zapara.Server.Communities\Zapara.Server.Communities.csproj" />
    <ProjectReference Include="..\Zapara.Server.Accounts\Zapara.Server.Accounts.csproj" />
    <ProjectReference Include="..\Zapara.AdminCli\Zapara.AdminCli.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.30" />
    <ProjectReference Include="..\Vograph.Timetable\Vograph.Timetable.csproj" />
    <ProjectReference Include="..\Zapara.Server.Timetable\Zapara.Server.Timetable.csproj" />
    <ProjectReference Include="..\Zapara.Server\Zapara.Server.csproj" />
    <ProjectReference Include="..\Zapara.Server.Social\Zapara.Server.Social.csproj" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.2.0" />
    <ProjectReference Include="..\Zapara.Ingest\Zapara.Ingest.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- ImageSharp 3.2.0 includes the backported fixes for these advisories (SixLabors/ImageSharp#3208), but GitHub's
         advisory database still lists 3.2.0 as affected. Suppress only these advisories; any other stays a warning. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" /> <!-- fixed in 3.2.0 via #3208 -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" /> <!-- fixed in 3.2.0 via #3208 -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" /> <!-- fixed in 3.2.0 via #3208 -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" /> <!-- fixed in 3.2.0 via #3208 -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" /> <!-- fixed in 3.2.0 via #3208 -->
  </ItemGroup>
  <ItemGroup>
    <None Update="Fixtures\*.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures\accounts\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

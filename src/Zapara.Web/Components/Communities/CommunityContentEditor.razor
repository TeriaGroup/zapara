@using Zapara.Contracts.Communities
<Modal Title="@Title" OnClose="Close" Class="community-editor">
    @if (discard)
    {
        <p>Отменить несохранённые изменения?</p>
        <div class="form-actions"><button class="button" @onclick="() => discard = false">Продолжить редактирование</button><button class="button danger" @onclick="() => OnClose.InvokeAsync()">Отменить изменения</button></div>
    }
    else
    {
        <form class="stack" @onsubmit="Save" @onsubmit:preventDefault>
            <label class="field"><span>Заголовок</span><input required maxlength="200" @bind="title" @bind:event="oninput" disabled="@Busy" /></label>
            <label class="field"><span>Текст</span><textarea required maxlength="8000" rows="8" @bind="body" @bind:event="oninput" disabled="@Busy"></textarea><span class="caption muted">@body.Length / 8000</span></label>
            @if (Error is not null || validation is not null) { <p class="community-inline-error" role="alert">@(validation ?? Error)</p> }
            @if (!Allowed && !Busy) { <p class="muted">Отправка недоступна. Текст остаётся в этом окне; обновите сообщество и проверьте права.</p> }
            <div class="form-actions"><button type="button" class="button" disabled="@Busy" @onclick="Close">Отмена</button><button type="submit" class="button primary" disabled="@(Busy || !Allowed)">@(Busy ? "Сохраняем…" : "Сохранить")</button></div>
        </form>
    }
</Modal>
@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string InitialTitle { get; set; } = "";
    [Parameter] public string InitialBody { get; set; } = "";
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool Allowed { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public EventCallback<CommunityContentDraft> OnSave { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    private string title = "", body = "";
    private string? validation;
    private bool discard;
    protected override void OnInitialized() { title = InitialTitle; body = InitialBody; }
    private async Task Close() { if (Busy) return; if (title != InitialTitle || body != InitialBody) discard = true; else await OnClose.InvokeAsync(); }
    private async Task Save()
    {
        if (Busy || !Allowed) return;
        try { _ = new HomeworkUpsert(title.Trim(), body, 0); validation = null; await OnSave.InvokeAsync(new(title.Trim(), body)); }
        catch (ArgumentException) { validation = "Проверьте заголовок и текст. Не более 200 и 8000 символов соответственно."; }
    }
}

@page "/week"
@implements IDisposable
@inject WebAppState State
@inject BrowserApiClient Api
@inject BrowserCatalogViewState View
<PageTitle>Неделя — Расписание военмех</PageTitle>
@{ var shownScope = viewScope; }

<section class="page catalog-page week-page">
    <div class="page-heading">
        <div><h1>Неделя</h1><p class="muted">Всё расписание по дням</p></div>
        <button class="button catalog-group" @onclick="() => showGroups = true"><Icon Name="calendar" />@State.GroupName</button>
    </div>
    <div class="catalog-controls">
        <div class="segmented" role="group" aria-label="Недели в расписании">
            @foreach (var item in Parities) { <button class="@(parity == item.Code ? "active" : "")" aria-pressed="@(parity == item.Code)" @onclick="() => Change(shownScope, () => parity = item.Code)">@item.Title</button> }
        </div>
        <div class="toolbar">
            <button class="icon-button outlined" aria-label="Предыдущие две недели" @onclick="() => Change(shownScope, () => Move(-14))"><Icon Name="left" /></button>
            <button class="button" @onclick="() => Change(shownScope, Today)">Сегодня</button>
            <button class="icon-button outlined" aria-label="Следующие две недели" @onclick="() => Change(shownScope, () => Move(14))"><Icon Name="right" /></button>
        </div>
    </div>
    @if (filterDay != 0 || filterKind.Length > 0 || filterSubject.Length > 0) { <p class="caption muted">Выбрано из сводки: @(filterDay != 0 ? ParityService.DayNumberToTitle(filterDay) : "") @filterKind @filterSubject <button class="button" @onclick="() => Change(shownScope, ResetFilters)">Показать все занятия</button></p> }
    @if (!State.Ready) { <div class="skeleton-card" role="status">Загружаем расписание недели…</div> }
    else if (State.Schedule is null) { <div class="empty-state"><Icon Name="week" /><h2>Расписание пока недоступно</h2><p>Подключитесь к сети и обновите данные.</p><button class="button" disabled="@State.Refreshing" @onclick="State.RefreshAsync">Повторить</button></div> }
    else if (State.GroupId.Length == 0) { <div class="empty-state"><Icon Name="week" /><h2>Выберите свою группу</h2><p>Покажем пары на обе недели семестра.</p><button class="button primary" @onclick="() => showGroups = true">Выбрать группу</button></div> }
    else
    {
        @foreach (var monday in Weeks)
        {
            <section class="week-block" aria-label="@WeekHeading(monday)">
                <header class="catalog-section-heading"><h2>@WeekHeading(monday)</h2><span class="muted">@monday.ToString("d MMMM") — @monday.AddDays(5).ToString("d MMMM")</span></header>
                <div class="week-grid">
                    @foreach (var day in Enumerable.Range(0, 6).Select(offset => monday.AddDays(offset)).Where(date => filterDay == 0 || (int)date.DayOfWeek == filterDay))
                    {
                        var lessons = ScheduleRules.ForDate(State.Schedule, State.GroupId, day, State.Settings.ParityInvert).Where(lesson =>
                            (filterKind.Length == 0 || BrowserCatalogNavigation.TypeCode(lesson.TypeRaw) == BrowserCatalogNavigation.TypeCode(filterKind)) &&
                            (filterSubject.Length == 0 || State.DisplayName(lesson).Equals(filterSubject, StringComparison.OrdinalIgnoreCase) || ParityService.SameSubject(lesson.SubjectRaw, filterSubject))).ToList();
                        <article class="week-day @(day.Date == State.Today.Date ? "is-today" : "")" aria-label="@day.ToString("dddd, d MMMM")">
                            <header class="week-day-heading"><div><h3>@day.ToString("dddd")</h3><span class="muted">@day.ToString("d MMMM")</span></div>@if (day.Date == State.Today.Date) { <span class="catalog-badge">Сегодня</span> }</header>
                            @if (lessons.Count == 0) { <p class="week-empty">Пар нет</p> }
                            @foreach (var lesson in lessons)
                            {
                                <div class="week-lesson">
                                    <div class="week-time"><strong>@lesson.TimeStart</strong><span>@lesson.TimeEnd</span></div>
                                    <div class="week-lesson-body"><span class="lesson-type @Schedule.TypeClass(lesson.TypeRaw)">@lesson.TypeRaw</span><h3>@State.DisplayName(lesson)</h3><p class="muted">@lesson.TeacherRaw</p>
                                        @if (!string.IsNullOrWhiteSpace(lesson.ClassroomRaw)) { <a class="catalog-room" href="@("maps?room=" + Uri.EscapeDataString(lesson.ClassroomRaw))"><Icon Name="pin" />@lesson.ClassroomRaw.TrimEnd(';', ' ')</a> }
                                        @if (!string.IsNullOrWhiteSpace(State.LessonNote(lesson))) { <p class="lesson-note">@State.LessonNote(lesson)</p> }
                                    </div>
                                </div>
                            }
                        </article>
                    }
                </div>
            </section>
        }
    }
</section>
@if (showGroups) { <GroupPicker OnClose="() => showGroups = false" /> }

@code {
    private static readonly (int Code, string Title)[] Parities = [(0, "Обе недели"), (1, "Нечётная"), (2, "Чётная")];
    private int parity;
    private bool showGroups;
    private DateTime anchor = Monday(DateTime.Today);
    private CatalogViewScope viewScope = new("", -1, "");
    private int filterDay;
    private string filterKind = "", filterSubject = "";
    [Parameter, SupplyParameterFromQuery(Name="day")] public int? RequestedDay { get; set; }
    [Parameter, SupplyParameterFromQuery(Name="kind")] public string? RequestedKind { get; set; }
    [Parameter, SupplyParameterFromQuery(Name="subject")] public string? RequestedSubject { get; set; }
    private string? appliedQuery;
    private IEnumerable<DateTime> Weeks
    {
        get
        {
            if (parity == 0) return [anchor, anchor.AddDays(7)];
            return [State.Schedule is { } snapshot && ScheduleRules.WeekCode(snapshot, anchor, State.Settings.ParityInvert) != parity ? anchor.AddDays(7) : anchor];
        }
    }
    private string WeekHeading(DateTime monday) => State.Schedule is { } snapshot && ScheduleRules.WeekCode(snapshot, monday, State.Settings.ParityInvert) == 2 ? "Чётная неделя" : "Нечётная неделя";
    private static DateTime Monday(DateTime value) => value.Date.AddDays(-(((int)value.DayOfWeek + 6) % 7));
    private void Move(int days) => anchor = anchor.AddDays(days);
    private void ResetFilters() { filterDay = 0; filterKind = filterSubject = ""; }
    private void Today() => anchor = Monday(State.Today);
    protected override void OnInitialized() { State.Changed += Changed; Restore(); }
    protected override void OnParametersSet()
    {
        Restore();
        var query = $"{RequestedDay}|{RequestedKind}|{RequestedSubject}";
        if (query == appliedQuery || (RequestedDay is null && RequestedKind is null && RequestedSubject is null)) return;
        appliedQuery = query;
        Change(viewScope, () => { filterDay = RequestedDay is >= 1 and <= 6 ? RequestedDay.Value : 0; filterKind = RequestedKind?[..Math.Min(RequestedKind.Length, 128)] ?? ""; filterSubject = RequestedSubject?[..Math.Min(RequestedSubject.Length, 1024)] ?? ""; });
    }
    private void Restore()
    {
        var current = new CatalogViewScope(State.ProfileKey, State.Generation, State.GroupId);
        if (current == viewScope) return;
        viewScope = View.Activate(current.Owner, current.Generation, current.Group);
        var value = View.Week(viewScope, State.Today);
        anchor = value.Anchor; parity = value.Parity; filterDay = value.Day; filterKind = value.Kind; filterSubject = value.Subject; showGroups = false;
    }
    private void Change(CatalogViewScope scope, Action action)
    {
        if (Api.Transitioning || scope != new CatalogViewScope(State.ProfileKey, State.Generation, State.GroupId)) return;
        action(); View.Save(scope, new WeekView(anchor, parity, filterDay, filterKind, filterSubject));
    }
    private void Changed() { Restore(); _ = InvokeAsync(StateHasChanged); }
    public void Dispose() => State.Changed -= Changed;
}

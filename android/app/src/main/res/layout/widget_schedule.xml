<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_schedule_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_light"
    android:orientation="vertical"
    android:padding="12dp"
    android:contentDescription="@string/nav_schedule">

    <TextView
        android:id="@+id/widget_schedule_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_medium"
        android:text="@string/nav_schedule"
        android:textColor="@color/widget_text1"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/widget_schedule_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/inter_regular"
        android:textColor="@color/widget_text2"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/widget_schedule_row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView
            android:id="@+id/widget_schedule_name1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_medium"
            android:textColor="@color/widget_text1"
            android:textSize="15sp"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/widget_schedule_meta1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_regular"
            android:textColor="@color/widget_text2"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_schedule_row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView
            android:id="@+id/widget_schedule_name2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_medium"
            android:textColor="@color/widget_text1"
            android:textSize="15sp"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/widget_schedule_meta2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_regular"
            android:textColor="@color/widget_text2"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_schedule_row3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView
            android:id="@+id/widget_schedule_name3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_medium"
            android:textColor="@color/widget_text1"
            android:textSize="15sp"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/widget_schedule_meta3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_regular"
            android:textColor="@color/widget_text2"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_schedule_row4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView
            android:id="@+id/widget_schedule_name4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_medium"
            android:textColor="@color/widget_text1"
            android:textSize="15sp"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/widget_schedule_meta4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_regular"
            android:textColor="@color/widget_text2"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_schedule_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/inter_regular"
        android:textColor="@color/widget_text2"
        android:textSize="15sp"
        android:visibility="gone" />
</LinearLayout>

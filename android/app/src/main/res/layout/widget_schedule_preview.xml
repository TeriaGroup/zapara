<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_schedule_preview_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/widget_schedule_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/inter_medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/nav_schedule"
            android:textColor="@color/widget_text1"
            android:textSize="17sp" />

        <LinearLayout
            android:id="@+id/widget_schedule_row1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_schedule_name1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter_medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_schedule_preview_subject1"
                    android:textColor="@color/widget_text1"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/widget_schedule_meta1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter_regular"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_schedule_preview_meta1"
                    android:textColor="@color/widget_text2"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_schedule_num1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/inter_medium"
                android:includeFontPadding="false"
                android:gravity="center"
                android:minWidth="16dp"
                android:text="@string/widget_schedule_preview_number1"
                android:textColor="@color/widget_text2"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_schedule_row2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_schedule_name2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter_medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_schedule_preview_subject2"
                    android:textColor="@color/widget_text1"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/widget_schedule_meta2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter_regular"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_schedule_preview_meta2"
                    android:textColor="@color/widget_text2"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_schedule_num2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/inter_medium"
                android:includeFontPadding="false"
                android:gravity="center"
                android:minWidth="16dp"
                android:text="@string/widget_schedule_preview_number2"
                android:textColor="@color/widget_text2"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
